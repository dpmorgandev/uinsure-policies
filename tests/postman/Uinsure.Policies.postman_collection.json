    {
      "name": "F1 Sell",
      "description": "POST /policies, each read back with GET /policies/{reference}. Real-time rows only: the SELL-3 29 Feb case and the BST/GMT boundaries need a fake clock and are integration-test only.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// F1 Sell: dates from the real UK today (Postman can't fake time) and a fresh reference per request.",
              "const pad = n => String(n).padStart(2, '0');",
              "const ukToday = (() => {",
              "    try {",
              "        const text = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/London' });",
              "        if (/^\\d{4}-\\d{2}-\\d{2}$/.test(text)) { return text; }",
              "    } catch (e) { /* no time-zone data: fall back to the machine's local date */ }",
              "    const now = new Date();",
              "    return now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());",
              "})();",
              "const parts = iso => iso.split('-').map(Number);",
              "const utcIso = (y, m, d) => new Date(Date.UTC(y, m - 1, d)).toISOString().slice(0, 10);",
              "const addDays = (iso, n) => { const [y, m, d] = parts(iso); return utcIso(y, m, d + n); };",
              "const addYears = (iso, n) => { const [y, m, d] = parts(iso); return utcIso(y + n, m, d); };",
              "// SELL-3: start + 1 year - 1 day; a 29 Feb start ends on 28 Feb of the next year.",
              "const endFor = iso => { const [y, m, d] = parts(iso); return m === 2 && d === 29 ? utcIso(y + 1, 2, 28) : addDays(addYears(iso, 1), -1); };",
              "const start = addDays(ukToday, 15);",
              "pm.variables.set('today', ukToday);",
              "pm.variables.set('yesterday', addDays(ukToday, -1));",
              "pm.variables.set('todayPlus60', addDays(ukToday, 60));",
              "pm.variables.set('todayPlus61', addDays(ukToday, 61));",
              "pm.variables.set('start', start);",
              "pm.variables.set('startEnd', endFor(start));",
              "pm.variables.set('dob16OnStart', addYears(start, -16));",
              "pm.variables.set('dob16DayAfterStart', addDays(addYears(start, -16), 1));",
              "pm.variables.set('dob16DayAfterPlus61', addDays(addYears(addDays(ukToday, 61), -16), 1));",
              "const reference = 'F1-' + Date.now().toString(36).toUpperCase() + Math.floor(Math.random() * 1296).toString(36).toUpperCase().padStart(2, '0');",
              "pm.variables.set('reference', reference);",
              "pm.variables.set('referenceLower', reference.toLowerCase());",
              "pm.variables.set('reference20', (reference + 'XXXXXXXXXXXXXXXXXXXX').slice(0, 20));",
              "pm.variables.set('reference21', (reference + 'XXXXXXXXXXXXXXXXXXXXX').slice(0, 21));"
            ]
          }
        }
      ],
