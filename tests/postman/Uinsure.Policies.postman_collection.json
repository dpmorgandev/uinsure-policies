              "name": "SELL-1 · duplicate reference → 409",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Sell the first policy, so this request is the duplicate.",
                      "const first = {",
                      "    reference: pm.variables.get(\"reference\"), type: \"Household\", startDate: pm.variables.get(\"start\"), amount: 365.00,",
                      "    autoRenew: true, paymentMethod: \"DirectDebit\",",
                      "    policyholders: [{ firstName: \"Ada\", lastName: \"Lovelace\", dateOfBirth: \"1985-12-10\" }],",
                      "    property: { addressLine1: \"1 High St\", addressLine2: null, addressLine3: null, postcode: \"M1 1AA\" }",
                      "};",
                      "pm.sendRequest({",
                      "    url: pm.variables.get(\"baseUrl\") + \"/policies\",",
                      "    method: \"POST\",",
                      "    header: { \"Content-Type\": \"application/json\" },",
                      "    body: { mode: \"raw\", raw: JSON.stringify(first) }",
                      "}, function (err, res) {",
                      "    if (err || res.code !== 201) { throw new Error(\"SELL-1 precondition: the first sale did not return 201\"); }",
                      "});"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"SELL-1 · duplicate reference answers 409 /problems/sell-1\", function () {",
                      "    pm.response.to.have.status(409);",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                      "    const problem = pm.response.json();",
                      "    pm.expect(problem.type).to.eql(\"/problems/sell-1\");",
                      "    pm.expect(problem.title).to.eql(\"Policy reference already exists\");",
                      "    pm.expect(problem.ruleId).to.eql(\"SELL-1\");",
                      "    pm.expect(problem.instance).to.eql(\"/policies\");",
                      "    pm.expect(problem.traceId).to.be.a(\"string\").and.not.empty;",
                      "    pm.expect(problem).to.not.have.property(\"violations\");",
                      "    pm.expect(problem.reference).to.eql(pm.variables.get(\"reference\"));",
                      "});",
                      "pm.sendRequest(pm.variables.get(\"baseUrl\") + \"/policies/\" + pm.variables.get(\"reference\"), function (err, res) {",
                      "    pm.test(\"SELL-1 · the original policy is unchanged\", function () {",
                      "        pm.expect(err).to.eql(null);",
                      "        pm.expect(res.code).to.eql(200);",
                      "        pm.expect(res.json().amount).to.eql(365);",
                      "    });",
                      "});"
