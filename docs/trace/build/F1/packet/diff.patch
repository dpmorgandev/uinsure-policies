@@ -0,0 +1,77 @@
+using System.Globalization;
+using System.Net;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using Xunit;
+
+namespace Uinsure.Policies.Api.Tests.Support;
+
+// HTTP helpers for the /policies routes. Every Sell test is a POST → GET round trip through these.
+internal static class PoliciesClient
+{
+    public static Task<HttpResponseMessage> PostPolicy(this HttpClient client, JsonObject body) =>
+        client.PostPolicy(body.ToJsonString());
+
+    // Raw text, so a test can send JSON that no JsonObject can represent (malformed, truncated).
+    public static async Task<HttpResponseMessage> PostPolicy(this HttpClient client, string json)
+    {
+        using var content = new StringContent(json, Encoding.UTF8, "application/json");
+        return await client.PostAsync("/policies", content, TestContext.Current.CancellationToken);
+    }
+
+    public static Task<HttpResponseMessage> GetPolicy(this HttpClient client, string reference) =>
+        client.GetAsync("/policies/" + Uri.EscapeDataString(reference), TestContext.Current.CancellationToken);
+
+    public static async Task<JsonElement> ReadJson(this HttpResponseMessage response)
+    {
+        var text = await response.Content.ReadAsStringAsync(TestContext.Current.CancellationToken);
+        using var document = JsonDocument.Parse(text);
+        return document.RootElement.Clone();
+    }
+
+    // The Location header's path, whether the app writes it absolute or relative.
+    public static string LocationPath(this HttpResponseMessage response)
+    {
+        var location = response.Headers.Location;
+        Assert.NotNull(location);
+        return location.IsAbsoluteUri ? location.AbsolutePath : location.OriginalString;
+    }
+
+    // POST → 201 with Location /policies/{expectedReference} → GET that Location → 200.
+    // Returns the policy as read back, so the test asserts what was stored, not what was echoed.
+    public static async Task<JsonElement> SellAndReadBack(this HttpClient client, JsonObject body, string expectedReference)
+    {
+        using var sold = await client.PostPolicy(body);
+        Assert.Equal(HttpStatusCode.Created, sold.StatusCode);
+        var location = sold.LocationPath();
+        Assert.Equal($"/policies/{expectedReference}", location);
+
+        using var read = await client.GetAsync(location, TestContext.Current.CancellationToken);
+        Assert.Equal(HttpStatusCode.OK, read.StatusCode);
+        var policy = await read.ReadJson();
+        Assert.Equal(expectedReference, policy.GetProperty("reference").GetString());
+        return policy;
+    }
+
+    // The round trip of a rejected sale: nothing was stored under the reference.
+    public static async Task AssertNotStored(this HttpClient client, string reference)
+    {
+        using var read = await client.GetPolicy(reference);
+        Assert.Equal(HttpStatusCode.NotFound, read.StatusCode);
+    }
+
+    // A member that must be present: a missing one fails as an assertion that names it, not as a
+    // KeyNotFoundException.
+    public static JsonElement Member(this JsonElement element, string property)
+    {
+        Assert.True(element.TryGetProperty(property, out var value), $"The body has no '{property}' member.");
+        return value;
+    }
+
+    // A DateOnly member, which the contract writes as yyyy-MM-dd.
+    public static DateOnly GetDate(this JsonElement element, string property) =>
+        DateOnly.ParseExact(element.Member(property).GetString() ?? string.Empty, "yyyy-MM-dd", CultureInfo.InvariantCulture);
+
+    public static string Iso(this DateOnly date) => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
+}
diff --git a/tests/Uinsure.Policies.Api.Tests/Support/ProblemAssert.cs b/tests/Uinsure.Policies.Api.Tests/Support/ProblemAssert.cs
new file mode 100644
index 0000000..6cc4fb4
--- /dev/null
+++ b/tests/Uinsure.Policies.Api.Tests/Support/ProblemAssert.cs
@@ -0,0 +1,99 @@
+using System.Net;
+using System.Text.Json;
+using Xunit;
+
+namespace Uinsure.Policies.Api.Tests.Support;
+
+// RFC 9457 bodies per the API contract. Status first, then the body.
+internal static class ProblemAssert
+{
+    // A 422 with exactly one violation: the rule's own type, title and ruleId at the top level, and its
+    // detail repeated as the single violations[] entry. Returns the body for the extension assertions.
+    public static async Task<JsonElement> SingleRuleViolation(HttpResponseMessage response, string ruleId, string title)
+    {
+        var problem = await RuleProblem(response, HttpStatusCode.UnprocessableEntity, ruleId, title);
+
+        var violation = Assert.Single(problem.GetProperty("violations").EnumerateArray());
+        Assert.Equal(ruleId, violation.GetProperty("ruleId").GetString());
+        Assert.Equal(problem.GetProperty("detail").GetString(), violation.GetProperty("detail").GetString());
+        return problem;
+    }
+
+    // A 409 state conflict: short-circuits before the 422 rules, so it carries no violations[].
+    public static async Task<JsonElement> Conflict(HttpResponseMessage response, string ruleId, string title)
+    {
+        var problem = await RuleProblem(response, HttpStatusCode.Conflict, ruleId, title);
+
+        Assert.False(problem.TryGetProperty("violations", out _));
+        return problem;
+    }
+
+    // The members every rule problem carries: type /problems/{rule-id lower-case}, title, status, detail,
+    // instance (the request path), ruleId and traceId.
+    public static async Task<JsonElement> RuleProblem(HttpResponseMessage response, HttpStatusCode status, string ruleId, string title)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+
+        var problem = await response.ReadJson();
+        Assert.Equal($"/problems/{ruleId.ToLowerInvariant()}", problem.GetProperty("type").GetString());
+        Assert.Equal(title, problem.GetProperty("title").GetString());
+        Assert.Equal((int)status, problem.GetProperty("status").GetInt32());
+        Assert.False(string.IsNullOrWhiteSpace(problem.GetProperty("detail").GetString()));
+        Assert.Equal("/policies", problem.GetProperty("instance").GetString());
+        Assert.Equal(ruleId, problem.GetProperty("ruleId").GetString());
+        Assert.False(string.IsNullOrWhiteSpace(problem.GetProperty("traceId").GetString()));
+        return problem;
+    }
+
+    // A transport problem (the HTTPS check, the rate limiter, a BadHttpRequestException): RFC 9457 with a
+    // title, a detail, the request path as instance and a traceId, and no ruleId, because no rule is broken.
+    // The type is checked where the contract fixes one. Returns the body.
+    public static async Task<JsonElement> TransportProblem(HttpResponseMessage response, HttpStatusCode status, string instance, string? type = null)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+
+        var problem = await response.ReadJson();
+        if (type is not null)
+        {
+            Assert.Equal(type, problem.GetProperty("type").GetString());
+        }
+
+        Assert.False(string.IsNullOrWhiteSpace(problem.GetProperty("title").GetString()));
+        Assert.Equal((int)status, problem.GetProperty("status").GetInt32());
+        Assert.False(string.IsNullOrWhiteSpace(problem.GetProperty("detail").GetString()));
+        Assert.Equal(instance, problem.GetProperty("instance").GetString());
+        Assert.False(string.IsNullOrWhiteSpace(problem.GetProperty("traceId").GetString()));
+        Assert.False(problem.TryGetProperty("ruleId", out _));
+        return problem;
+    }
+
+    // A 400 shape error: ValidationProblemDetails with a non-empty errors map and a traceId, no ruleId.
+    // Returns the errors map.
+    public static async Task<JsonElement> ValidationErrors(HttpResponseMessage response)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+
+        var problem = await response.ReadJson();
+        Assert.Equal(400, problem.GetProperty("status").GetInt32());
+        Assert.Equal("One or more validation errors occurred.", problem.GetProperty("title").GetString());
+        Assert.Equal("/policies", problem.GetProperty("instance").GetString());
+        Assert.False(string.IsNullOrWhiteSpace(problem.GetProperty("traceId").GetString()));
+        Assert.False(problem.TryGetProperty("ruleId", out _));
+
+        var errors = problem.GetProperty("errors");
+        Assert.Equal(JsonValueKind.Object, errors.ValueKind);
+        Assert.NotEmpty(errors.EnumerateObject());
+        return errors;
+    }
+
+    // An errors-map entry for the field, keyed as the contract writes it (camelCase JSON names,
+    // "$.x" for a JSON-reader error).
+    public static void HasError(JsonElement errors, string key)
+    {
+        Assert.True(errors.TryGetProperty(key, out var messages), $"errors has no '{key}' entry: {errors}");
+        Assert.NotEmpty(messages.EnumerateArray());
+    }
+}
