+using Uinsure.Policies.Api.Tests.Builders;
+using Uinsure.Policies.Api.Tests.Support;
+using Xunit;
+
+namespace Uinsure.Policies.Api.Tests;
+
+// CANCEL-6: a refund is rounded once, to 2 dp, half away from zero (.NET's default is banker's rounding, half to
+// even). Only a 366-day term can put a pro-rata refund exactly on half a penny (amount × unused ÷ 365 never
+// ends in .xx5), so the policy starts 2027-03-01 and ends 2028-02-29, sold with the clock at 2027-02-01. Money is
+// asserted as the raw JSON text: an unrounded 50.005 would show as itself, a banker's 50.00 as 50.00. The quote
+// side of the row is CancellationQuoteTests; the rows whose refund has more than 2 dp before rounding are
+// CancelProRataTests and CancellationQuoteTests.
+public sealed class CancelRoundingTests : IClassFixture<PoliciesApiFactory>
+{
+    private readonly PoliciesApiFactory _factory;
+
+    public CancelRoundingTests(PoliciesApiFactory factory)
+    {
+        _factory = factory;
+        _factory.ResetClock();
+    }
+
+    // 2027-08-30: 183 days used, 183 unused; 100.01 × 183 ÷ 366 = 50.005 exactly → 50.01.
+    [Fact]
+    [Trait("Rule", "CANCEL-6")]
+    [Trait("Rule", "CANCEL-1c")]
+    public async Task Refund_of_exactly_half_a_penny_rounds_away_from_zero()
+    {
+        _factory.Clock.SetUtcNow(new DateTimeOffset(2027, 2, 1, 12, 0, 0, TimeSpan.Zero));
+        const string reference = "CAN6-HALF-PENNY";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(new DateOnly(2027, 3, 1)).WithAmount(100.01m).WithPaymentMethod("Card").Build();
+        using var client = _factory.CreateClient();
+        var paymentReference = (await client.SellAndReadBack(sold, reference)).PaymentReference();
+
+        using var response = await client.PostCancellation(reference, new CancellationRequestBuilder().WithDate(new DateOnly(2027, 8, 30)).Build());
+
+        await OneTermCancellation.AssertCancelledAndReadBack(
+            client, response, reference, sold, new DateOnly(2028, 2, 29), paymentReference,
+            new DateOnly(2027, 8, 30), "CANCEL-1c", 366, 183, 183, "50.01", "Card");
+    }
+}
diff --git a/tests/Uinsure.Policies.Api.Tests/CancelShapeTests.cs b/tests/Uinsure.Policies.Api.Tests/CancelShapeTests.cs
new file mode 100644
index 0000000..e7d67ca
--- /dev/null
+++ b/tests/Uinsure.Policies.Api.Tests/CancelShapeTests.cs
@@ -0,0 +1,75 @@
+using Uinsure.Policies.Api.Tests.Builders;
+using Uinsure.Policies.Api.Tests.Support;
+using Xunit;
+
+namespace Uinsure.Policies.Api.Tests;
+
+// E3, the shape of the optional cancellation body (CANCEL-3) and an unknown reference. A body that is sent must
+// be valid: malformed JSON, an unknown field or a date that is not yyyy-MM-dd is a 400 ValidationProblemDetails
+// with no ruleId, returned before any rule, and the policy is left as sold. An unknown reference is 404 GET-1.
+//   start 2026-11-08 ends 2027-11-07 (the builder's default sale).
+public sealed class CancelShapeTests : IClassFixture<PoliciesApiFactory>
+{
+    private static readonly DateOnly DefaultEnd = new(2027, 11, 7);
+
+    private readonly PoliciesApiFactory _factory;
+
+    public CancelShapeTests(PoliciesApiFactory factory)
+    {
+        _factory = factory;
+        _factory.ResetClock();
+    }
+
+    [Fact]
+    [Trait("Rule", "CANCEL-3")]
+    public async Task Cancel_with_an_unknown_field_is_rejected_with_400()
+    {
+        var body = new CancellationRequestBuilder().Build();
+        body["reason"] = "Moving abroad";
+
+        await AssertShape("CAN-SHAPE-UNKNOWN", body.ToJsonString(), "$.reason");
+    }
+
+    [Fact]
+    [Trait("Rule", "CANCEL-3")]
+    public async Task Cancel_with_a_cancellationDate_not_in_yyyy_MM_dd_is_rejected_with_400()
+    {
+        await AssertShape("CAN-SHAPE-BAD-DATE", "{\"cancellationDate\": \"26/11/2026\"}", "$.cancellationDate");
+    }
+
+    [Fact]
+    [Trait("Rule", "CANCEL-3")]
+    public async Task Cancel_with_malformed_JSON_is_rejected_with_400()
+    {
+        await AssertShape("CAN-SHAPE-MALFORMED", "{\"cancellationDate\": \"2026-11-26\"", errorKey: null);
+    }
+
+    [Fact]
+    [Trait("Rule", "GET-1")]
+    public async Task Cancel_of_an_unknown_reference_answers_404()
+    {
+        using var client = _factory.CreateClient();
+
+        using var response = await client.PostCancellation("CAN-NO-SUCH", new CancellationRequestBuilder().Build());
+
+        await ProblemAssert.NotFound(response, PolicyActions.CancellationPath("CAN-NO-SUCH"), "CAN-NO-SUCH");
+    }
+
+    // errorKey null: malformed JSON, whose errors entry the JSON reader names.
+    private async Task AssertShape(string reference, string json, string? errorKey)
+    {
+        var sold = new SellPolicyRequestBuilder(reference).Build();
+        using var client = _factory.CreateClient();
+        await client.SellAndReadBack(sold, reference);
+
+        using var response = await client.PostCancellation(reference, json);
+
+        var errors = await ProblemAssert.ValidationErrors(response, PolicyActions.CancellationPath(reference));
+        if (errorKey is not null)
+        {
+            ProblemAssert.HasError(errors, errorKey);
+        }
+
+        PolicyStateAssert.ReadsBackUnchanged(await client.ReadBack(reference), sold, reference, DefaultEnd, "Pending");
+    }
+}
diff --git a/tests/Uinsure.Policies.Api.Tests/CancelTwiceTests.cs b/tests/Uinsure.Policies.Api.Tests/CancelTwiceTests.cs
new file mode 100644
index 0000000..523add6
--- /dev/null
+++ b/tests/Uinsure.Policies.Api.Tests/CancelTwiceTests.cs
@@ -0,0 +1,104 @@
+using System.Text.Json.Nodes;
+using Uinsure.Policies.Api.Tests.Builders;
+using Uinsure.Policies.Api.Tests.Support;
+using Xunit;
+
+namespace Uinsure.Policies.Api.Tests;
+
+// CANCEL-4: a cancelled policy can't be cancelled again, or quoted. 409 /problems/cancel-4, giving the original
+// cancellation date (extension cancellationDate, and named in the detail). A 409 short-circuits, so it is
+// returned before any 422 date rule. The first cancellation stays exactly as it was stored.
+//   start 2026-10-17 ends 2027-10-16; start 2026-11-08 ends 2027-11-07 (both 365 days).
+public sealed class CancelTwiceTests : IClassFixture<PoliciesApiFactory>
+{
+    private const string Title = "Policy already cancelled";
+
+    private readonly PoliciesApiFactory _factory;
+
+    public CancelTwiceTests(PoliciesApiFactory factory)
+    {
+        _factory = factory;
+        _factory.ResetClock();
+    }
+
+    // First cancellation 2027-01-20: 96 days used, 269 unused; 458.12 × 269 ÷ 365 = 337.62816… → 337.63.
+    [Fact]
+    [Trait("Rule", "CANCEL-4")]
+    public async Task Cancelling_a_cancelled_policy_answers_409_with_the_original_cancellation_date()
+    {
+        const string reference = "CAN4-TWICE";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(TestClock.Today).WithAmount(458.12m).WithPaymentMethod("Card").Build();
+        var first = await SellAndCancel(reference, sold, new DateOnly(2027, 1, 20));
+        using var client = _factory.CreateClient();
+
+        using var response = await client.PostCancellation(reference, new CancellationRequestBuilder().WithDate(new DateOnly(2027, 2, 14)).Build());
+
+        var problem = await ProblemAssert.Conflict(response, "CANCEL-4", Title, PolicyActions.CancellationPath(reference));
+        Assert.Equal(new DateOnly(2027, 1, 20), problem.GetDate("cancellationDate"));
+        Assert.Contains("2027-01-20", problem.Member("detail").GetString());
+        PolicyStateAssert.ReadsBack(
+            await client.ReadBack(reference), sold, reference, new DateOnly(2027, 10, 16), "Cancelled", false,
+            new ExpectedCancellationSummary(new DateOnly(2027, 1, 20), "CANCEL-1c", "337.63"),
+            [new ExpectedPolicyRefund(first.RefundReference, "Card", "337.63", first.PaymentReference)],
+            []);
+    }
+
+    // The second request also carries a past date (a 422 CANCEL-3 on its own): the 409 wins. The first
+    // cancellation was today, 2026-10-17, before the 2026-11-08 start: CANCEL-1a, 512.00 back by Direct Debit.
+    [Fact]
+    [Trait("Rule", "CANCEL-4")]
+    public async Task Cancelling_twice_with_a_past_date_answers_409_before_the_date_rule()
+    {
+        const string reference = "CAN4-TWICE-PAST";
+        var sold = new SellPolicyRequestBuilder(reference).WithAmount(512.00m).Build();
+        var first = await SellAndCancel(reference, sold, TestClock.Today);
+        using var client = _factory.CreateClient();
+
+        using var response = await client.PostCancellation(reference, new CancellationRequestBuilder().WithDate(new DateOnly(2026, 10, 1)).Build());
+
+        var problem = await ProblemAssert.Conflict(response, "CANCEL-4", Title, PolicyActions.CancellationPath(reference));
+        Assert.Equal(TestClock.Today, problem.GetDate("cancellationDate"));
+        Assert.Contains("2026-10-17", problem.Member("detail").GetString());
+        PolicyStateAssert.ReadsBack(
+            await client.ReadBack(reference), sold, reference, new DateOnly(2027, 11, 7), "Cancelled", false,
+            new ExpectedCancellationSummary(TestClock.Today, "CANCEL-1a", "512.00"),
+            [new ExpectedPolicyRefund(first.RefundReference, "DirectDebit", "512.00", first.PaymentReference)],
+            []);
+    }
+
+    // E4 on a cancelled policy: there is nothing left to quote. First cancellation 2026-12-01: 46 days used,
+    // 319 unused; 318.90 × 319 ÷ 365 = 278.70986… → 278.71, back to the Cheque.
+    [Fact]
+    [Trait("Rule", "CANCEL-4")]
+    [Trait("Rule", "COULD-1")]
+    public async Task Quoting_a_cancelled_policy_answers_409_with_the_original_cancellation_date()
+    {
+        const string reference = "CAN4-QUOTE";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(TestClock.Today).WithAmount(318.90m).WithPaymentMethod("Cheque").Build();
+        var first = await SellAndCancel(reference, sold, new DateOnly(2026, 12, 1));
+        using var client = _factory.CreateClient();
+
+        using var response = await client.GetQuote(reference, new DateOnly(2027, 1, 5));
+
+        var problem = await ProblemAssert.Conflict(response, "CANCEL-4", Title, PolicyActions.QuotePath(reference));
+        Assert.Equal(new DateOnly(2026, 12, 1), problem.GetDate("cancellationDate"));
+        Assert.Contains("2026-12-01", problem.Member("detail").GetString());
+        PolicyStateAssert.ReadsBack(
+            await client.ReadBack(reference), sold, reference, new DateOnly(2027, 10, 16), "Cancelled", false,
+            new ExpectedCancellationSummary(new DateOnly(2026, 12, 1), "CANCEL-1c", "278.71"),
+            [new ExpectedPolicyRefund(first.RefundReference, "Cheque", "278.71", first.PaymentReference)],
+            []);
+    }
+
+    // Sell and cancel once (201). Returns the payment and the refund references, for the read-back.
+    private async Task<(string PaymentReference, string RefundReference)> SellAndCancel(string reference, JsonObject sold, DateOnly cancellationDate)
+    {
+        using var client = _factory.CreateClient();
+        var paymentReference = (await client.SellAndReadBack(sold, reference)).PaymentReference();
+        var body = await client.Cancel(reference, new CancellationRequestBuilder().WithDate(cancellationDate).Build());
+        var refund = Assert.Single(body.Member("refunds").EnumerateArray());
+        return (paymentReference, refund.Member("reference").GetString() ?? string.Empty);
+    }
+}
diff --git a/tests/Uinsure.Policies.Api.Tests/CancelWithClaimTests.cs b/tests/Uinsure.Policies.Api.Tests/CancelWithClaimTests.cs
new file mode 100644
index 0000000..4005103
--- /dev/null
+++ b/tests/Uinsure.Policies.Api.Tests/CancelWithClaimTests.cs
@@ -0,0 +1,107 @@
+using Uinsure.Policies.Api.Tests.Builders;
+using Uinsure.Policies.Api.Tests.Support;
+using Uinsure.Policies.Domain.Policies;
+using Xunit;
+
+namespace Uinsure.Policies.Api.Tests;
+
+// COULD-2: a policy with a claim is refunded £0 when cancelled, whichever of CANCEL-1a, 1b or 1c would apply.
+// The term's ruleApplied is COULD-2 and its refundAmount 0.00, with its day counts as usual, and no Refund
+// record is made, so refunds[] is empty in the response and the read-back. hasClaims stays true and the claim
+// stays listed. The policy is sold, claimed on (E5) and cancelled (E3), then read back whole:
+//   start 2026-10-17 ends 2027-10-16 (365 days).
+// No claim can predate the first start (COULD-2b), so the CANCEL-1a case is a policy stored with hasClaims
+// true and a start ten days ahead, seeded through the app's IPolicyRepository (PolicyBuilder, PolicySeeder):
+//   BuyToLet, auto-renew, Mary Jackson born 1984-04-09, 31 Deansgate, Floor 4, M3 2BA,
+//   one term 2026-10-27 to 2027-10-26 for 275.35 paid by Cheque.
+public sealed class CancelWithClaimTests : IClassFixture<PoliciesApiFactory>
+{
+    private static readonly DateOnly TodayStartEnd = new(2027, 10, 16);
+
+    private readonly PoliciesApiFactory _factory;
+
+    public CancelWithClaimTests(PoliciesApiFactory factory)
+    {
+        _factory = factory;
+        _factory.ResetClock();
+    }
+
+    // Claimed and cancelled today, the start date: CANCEL-1b would refund 441.90 in full.
+    [Fact]
+    [Trait("Rule", "COULD-2")]
+    public async Task Cancel_in_cooling_off_after_a_claim_refunds_nothing_under_COULD_2()
+    {
+        const string reference = "COULD2-COOLING-OFF";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(TestClock.Today).WithAmount(441.90m).WithPaymentMethod("Card").Build();
+        using var client = _factory.CreateClient();
+        await client.SellAndReadBack(sold, reference);
+        var claimReference = ClaimAssert.IsClaim(
+            await client.RecordClaim(reference, new ClaimRequestBuilder().WithDescription("Accidental damage to the television").Build()),
+            reference, TestClock.Today, "Accidental damage to the television");
+
+        using var response = await client.PostCancellationWithNoBody(reference);
+
+        _ = CancellationAssert.IsCancellation(await PolicyActions.CancelledBody(response), new ExpectedCancellation(
+            reference, TestClock.Today, "COULD-2", "0.00",
+            [new ExpectedTerm(1, "COULD-2", 365, 1, 364, "0.00")],
+            []));
+        PolicyStateAssert.ReadsBack(
+            await client.ReadBack(reference), sold, reference, TodayStartEnd, "Cancelled", true,
+            new ExpectedCancellationSummary(TestClock.Today, "COULD-2", "0.00"), [],
+            [new ExpectedClaim(claimReference, TestClock.Today, "Accidental damage to the television")]);
+    }
+
+    // UK today 2026-12-01 (start + 45), a claim dated 2026-11-20: CANCEL-1c would refund 447.82 (46 days used,
+    // 319 unused, of 512.40).
+    [Fact]
+    [Trait("Rule", "COULD-2")]
+    public async Task Cancel_after_cooling_off_after_a_claim_refunds_nothing_under_COULD_2()
+    {
+        const string reference = "COULD2-AFTER-COOLING";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(TestClock.Today).WithAmount(512.40m).WithPaymentMethod("DirectDebit").Build();
+        using var client = _factory.CreateClient();
+        await client.SellAndReadBack(sold, reference);
+        _factory.Clock.SetUtcNow(new DateTimeOffset(2026, 12, 1, 12, 0, 0, TimeSpan.Zero));
+        var claimReference = ClaimAssert.IsClaim(
+            await client.RecordClaim(reference, new ClaimRequestBuilder().WithClaimDate(new DateOnly(2026, 11, 20)).WithDescription("Frozen pipe burst in the loft").Build()),
+            reference, new DateOnly(2026, 11, 20), "Frozen pipe burst in the loft");
+
+        var body = await client.Cancel(reference, new CancellationRequestBuilder().WithDate(new DateOnly(2026, 12, 1)).Build());
+
+        _ = CancellationAssert.IsCancellation(body, new ExpectedCancellation(
+            reference, new DateOnly(2026, 12, 1), "COULD-2", "0.00",
+            [new ExpectedTerm(1, "COULD-2", 365, 46, 319, "0.00")],
+            []));
+        PolicyStateAssert.ReadsBack(
+            await client.ReadBack(reference), sold, reference, TodayStartEnd, "Cancelled", true,
+            new ExpectedCancellationSummary(new DateOnly(2026, 12, 1), "COULD-2", "0.00"), [],
+            [new ExpectedClaim(claimReference, new DateOnly(2026, 11, 20), "Frozen pipe burst in the loft")]);
+    }
+
+    // Seeded with hasClaims true, cancelled today (2026-10-17), before its 2026-10-27 start: CANCEL-1a would
+    // refund 275.35 in full.
+    [Fact]
+    [Trait("Rule", "COULD-2")]
+    public async Task Cancel_before_the_start_of_a_policy_with_claims_refunds_nothing_under_COULD_2()
+    {
+        const string reference = "COULD2-BEFORE-START";
+        var start = new DateOnly(2026, 10, 27);
+        await _factory.Seed(new PolicyBuilder(reference)
+            .WithHasClaims(true)
+            .WithTerms(new Term(start, 275.35m, new Payment("PAY-COULD2-BEFORE-START-1", PaymentMethod.Cheque, 275.35m)))
+            .Build());
+        using var client = _factory.CreateClient();
+
+        using var response = await client.PostCancellationWithNoBody(reference);
+
+        _ = CancellationAssert.IsCancellation(await PolicyActions.CancelledBody(response), new ExpectedCancellation(
+            reference, TestClock.Today, "COULD-2", "0.00",
+            [new ExpectedTerm(1, "COULD-2", 365, 0, 365, "0.00")],
+            []));
+        PolicyStateAssert.ReadsBack(
+            await client.ReadBack(reference), SeededSale.For(reference, start, 275.35m, "Cheque"), reference, new DateOnly(2027, 10, 26), "Cancelled", true,
+            new ExpectedCancellationSummary(TestClock.Today, "COULD-2", "0.00"), [], []);
+    }
+}
diff --git a/tests/Uinsure.Policies.Api.Tests/CancellationQuoteTests.cs b/tests/Uinsure.Policies.Api.Tests/CancellationQuoteTests.cs
new file mode 100644
index 0000000..bbe0455
--- /dev/null
+++ b/tests/Uinsure.Policies.Api.Tests/CancellationQuoteTests.cs
@@ -0,0 +1,327 @@
+using System.Net;
+using System.Text.Json.Nodes;
+using Uinsure.Policies.Api.Tests.Builders;
+using Uinsure.Policies.Api.Tests.Support;
+using Xunit;
+
+namespace Uinsure.Policies.Api.Tests;
+
+// COULD-1: E4 GET /policies/{reference}/cancellation-quote?cancellationDate= is the cancel calculation, read
+// only. It answers 200 with the E3 shape plus quotedOn (UK today); its refunds carry no reference, because
+// nothing is created; and the policy reads back unchanged afterwards. The quote and a later cancel for the same
+// date agree. The date rules (CANCEL-3, CANCEL-7) apply to a quote too. Refunds and day counts are
+// hand-worked literals:
+//   start 2026-10-17 ends 2027-10-16; start 2026-11-08 ends 2027-11-07 (both 365 days);
+//   start 2027-03-01 ends 2028-02-29 (366 days, sold with the clock at 2027-02-01).
+public sealed class CancellationQuoteTests : IClassFixture<PoliciesApiFactory>
+{
+    private static readonly DateOnly TodayStartEnd = new(2027, 10, 16);
+    private static readonly DateOnly FutureStart = new(2026, 11, 8);
+    private static readonly DateOnly FutureStartEnd = new(2027, 11, 7);
+
+    private readonly PoliciesApiFactory _factory;
+
+    public CancellationQuoteTests(PoliciesApiFactory factory)
+    {
+        _factory = factory;
+        _factory.ResetClock();
+    }
+
+    // 2027-04-12: 178 days used, 187 unused; 615.40 × 187 ÷ 365 = 315.28712… → 315.29, by Direct Debit.
+    // The quote, then the cancel for the same date: the same rule, day counts and refund, each a literal.
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    [Trait("Rule", "CANCEL-1c")]
+    public async Task Quote_and_a_later_cancel_for_the_same_date_agree()
+    {
+        const string reference = "QUOTE-AGREE";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(TestClock.Today).WithAmount(615.40m).WithPaymentMethod("DirectDebit").Build();
+        using var client = _factory.CreateClient();
+        var paymentReference = (await client.SellAndReadBack(sold, reference)).PaymentReference();
+        var cancellationDate = new DateOnly(2027, 4, 12);
+        var expected = new ExpectedCancellation(
+            reference, cancellationDate, "CANCEL-1c", "315.29",
+            [new ExpectedTerm(1, "CANCEL-1c", 365, 178, 187, "315.29")],
+            [new ExpectedRefund("DirectDebit", "315.29", paymentReference)]);
+
+        var quote = await client.Quote(reference, cancellationDate);
+        var cancellation = await client.Cancel(reference, new CancellationRequestBuilder().WithDate(cancellationDate).Build());
+
+        CancellationAssert.IsQuote(quote, expected, TestClock.Today);
+        var refundReferences = CancellationAssert.IsCancellation(cancellation, expected);
+        Assert.Equal(cancellation.Member("terms").GetRawText(), quote.Member("terms").GetRawText());
+        PolicyStateAssert.ReadsBack(
+            await client.ReadBack(reference), sold, reference, TodayStartEnd, "Cancelled", false,
+            new ExpectedCancellationSummary(cancellationDate, "CANCEL-1c", "315.29"),
+            [new ExpectedPolicyRefund(Assert.Single(refundReferences), "DirectDebit", "315.29", paymentReference)],
+            []);
+    }
+
+    // 2026-11-30 (start + 22): 23 days used, 342 unused; 384.26 × 342 ÷ 365 = 360.04635… → 360.05. The policy
+    // reads back byte for byte as before the quote, and a cancel afterwards is not refused as a second one.
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    public async Task Quote_changes_nothing_on_the_policy()
+    {
+        const string reference = "QUOTE-NO-CHANGE";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(FutureStart).WithAmount(384.26m).WithPaymentMethod("Card").Build();
+        using var client = _factory.CreateClient();
+        var paymentReference = (await client.SellAndReadBack(sold, reference)).PaymentReference();
+        var before = await ReadBackText(client, reference);
+
+        var quote = await client.Quote(reference, new DateOnly(2026, 11, 30));
+
+        CancellationAssert.IsQuote(quote, new ExpectedCancellation(
+            reference, new DateOnly(2026, 11, 30), "CANCEL-1c", "360.05",
+            [new ExpectedTerm(1, "CANCEL-1c", 365, 23, 342, "360.05")],
+            [new ExpectedRefund("Card", "360.05", paymentReference)]), TestClock.Today);
+        Assert.Equal(before, await ReadBackText(client, reference));
+        PolicyStateAssert.ReadsBackUnchanged(await client.ReadBack(reference), sold, reference, FutureStartEnd, "Pending");
+        _ = await client.Cancel(reference, new CancellationRequestBuilder().WithDate(new DateOnly(2026, 11, 30)).Build());
+    }
+
+    // 2026-10-25 is before the 2026-11-08 start: nothing used, 291.35 in full, back to the Cheque.
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    [Trait("Rule", "CANCEL-1a")]
+    public async Task Quote_before_the_start_quotes_a_full_refund_under_CANCEL_1a()
+    {
+        await AssertQuote(
+            "QUOTE-1A",
+            new SellPolicyRequestBuilder("QUOTE-1A").WithStartDate(FutureStart).WithAmount(291.35m).WithPaymentMethod("Cheque").Build(),
+            FutureStartEnd, "Pending", new DateOnly(2026, 10, 25), "CANCEL-1a", 365, 0, 365, "291.35", "Cheque");
+    }
+
+    // 2026-10-31 is start + 14, the last day of cooling-off: 15 days used, 503.60 in full.
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    [Trait("Rule", "CANCEL-1b")]
+    public async Task Quote_on_start_plus_14_quotes_a_full_refund_under_CANCEL_1b()
+    {
+        await AssertQuote(
+            "QUOTE-1B-PLUS-14",
+            new SellPolicyRequestBuilder("QUOTE-1B-PLUS-14").WithStartDate(TestClock.Today).WithAmount(503.60m).WithPaymentMethod("DirectDebit").Build(),
+            TodayStartEnd, "Active", new DateOnly(2026, 10, 31), "CANCEL-1b", 365, 15, 350, "503.60", "DirectDebit");
+    }
+
+    // 2026-11-01 is start + 15: 16 days used, 349 unused; 687.45 × 349 ÷ 365 = 657.31520… → 657.32 (rounded up:
+    // more than 2 dp before rounding, CANCEL-6).
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    [Trait("Rule", "CANCEL-1c")]
+    [Trait("Rule", "CANCEL-6")]
+    public async Task Quote_on_start_plus_15_quotes_the_unused_days_under_CANCEL_1c()
+    {
+        await AssertQuote(
+            "QUOTE-1C-PLUS-15",
+            new SellPolicyRequestBuilder("QUOTE-1C-PLUS-15").WithStartDate(TestClock.Today).WithAmount(687.45m).WithPaymentMethod("Card").Build(),
+            TodayStartEnd, "Active", new DateOnly(2026, 11, 1), "CANCEL-1c", 365, 16, 349, "657.32", "Card");
+    }
+
+    // UK today 2027-02-01. 2027-12-30 in the 366-day term 2027-03-01 to 2028-02-29: 305 days used, 61 unused.
+    // 120.03 × 61 ÷ 366 = 20.005 exactly: away from zero 20.01, where banker's rounding would give 20.00.
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    [Trait("Rule", "CANCEL-6")]
+    public async Task Quote_of_exactly_half_a_penny_rounds_away_from_zero()
+    {
+        _factory.Clock.SetUtcNow(new DateTimeOffset(2027, 2, 1, 12, 0, 0, TimeSpan.Zero));
+        await AssertQuote(
+            "QUOTE-HALF-PENNY",
+            new SellPolicyRequestBuilder("QUOTE-HALF-PENNY").WithStartDate(new DateOnly(2027, 3, 1)).WithAmount(120.03m).WithPaymentMethod("DirectDebit").Build(),
+            new DateOnly(2028, 2, 29), "Pending", new DateOnly(2027, 12, 30), "CANCEL-1c", 366, 305, 61, "20.01", "DirectDebit",
+            quotedOn: new DateOnly(2027, 2, 1));
+    }
+
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    [Trait("Rule", "CANCEL-3")]
+    public async Task Quote_for_a_past_date_is_rejected()
+    {
+        const string reference = "QUOTE-PAST";
+        var sold = new SellPolicyRequestBuilder(reference).WithStartDate(TestClock.Today).WithAmount(341.20m).Build();
+        using var client = _factory.CreateClient();
+        await client.SellAndReadBack(sold, reference);
+
+        using var response = await client.GetQuote(reference, TestClock.Today.AddDays(-1));
+
+        var problem = await ProblemAssert.SingleRuleViolation(response, "CANCEL-3", "Cancellation date in the past", PolicyActions.QuotePath(reference));
+        Assert.Equal(TestClock.Today, problem.GetDate("today"));
+        PolicyStateAssert.ReadsBackUnchanged(await client.ReadBack(reference), sold, reference, TodayStartEnd, "Active");
+    }
+
+    // One request, one UK today (finding A2/R1). The clock moves an hour forward on every read, from
+    // 2026-10-17T22:30Z (23:30 BST, UK 2026-10-17); a second read would be 23:30Z (00:30 BST, UK 2026-10-18).
+    // A quote for UK 2026-10-17 read once is 200 quoted on 2026-10-17: the date CANCEL-3 checks against is the
+    // quotedOn it answers with. Read twice, the past-date check sees 2026-10-18 and the quote is a 422.
+    // 2026-10-17 is the start date: 1 day used, 364 unused, 452.76 in full to the Card (CANCEL-1b).
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    [Trait("Rule", "CANCEL-3")]
+    public async Task Quote_read_across_UK_midnight_is_checked_and_quoted_on_one_UK_today()
+    {
+        const string reference = "QUOTE-ONE-TODAY";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(TestClock.Today).WithAmount(452.76m).WithPaymentMethod("Card").Build();
+        using var client = _factory.CreateClient();
+        var paymentReference = (await client.SellAndReadBack(sold, reference)).PaymentReference();
+
+        HttpResponseMessage response;
+        _factory.Clock.SetUtcNow(new DateTimeOffset(2026, 10, 17, 22, 30, 0, TimeSpan.Zero));
+        _factory.Clock.AutoAdvanceAmount = TimeSpan.FromHours(1);
+        try
+        {
+            response = await client.GetQuote(reference, new DateOnly(2026, 10, 17));
+        }
+        finally
+        {
+            _factory.Clock.AutoAdvanceAmount = TimeSpan.Zero;
+        }
+
+        using (response)
+        {
+            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+            CancellationAssert.IsQuote(await response.ReadJson(), new ExpectedCancellation(
+                reference, new DateOnly(2026, 10, 17), "CANCEL-1b", "452.76",
+                [new ExpectedTerm(1, "CANCEL-1b", 365, 1, 364, "452.76")],
+                [new ExpectedRefund("Card", "452.76", paymentReference)]), new DateOnly(2026, 10, 17));
+        }
+    }
+
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    [Trait("Rule", "CANCEL-7")]
+    public async Task Quote_for_the_day_after_the_end_of_cover_is_rejected()
+    {
+        const string reference = "QUOTE-AFTER-END";
+        var sold = new SellPolicyRequestBuilder(reference).WithStartDate(FutureStart).WithAmount(296.85m).WithPaymentMethod("Cheque").Build();
+        using var client = _factory.CreateClient();
+        await client.SellAndReadBack(sold, reference);
+
+        using var response = await client.GetQuote(reference, new DateOnly(2027, 11, 8));
+
+        var problem = await ProblemAssert.SingleRuleViolation(response, "CANCEL-7", "Cancellation date after the end of cover", PolicyActions.QuotePath(reference));
+        Assert.Equal(FutureStartEnd, problem.GetDate("latestEndDate"));
+        PolicyStateAssert.ReadsBackUnchanged(await client.ReadBack(reference), sold, reference, FutureStartEnd, "Pending");
+    }
+
+    // A claim on 2026-10-17, then a quote for 2026-10-20 (cooling-off): COULD-2, nothing to refund, no refund.
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    [Trait("Rule", "COULD-2")]
+    public async Task Quote_for_a_policy_with_a_claim_quotes_nothing_under_COULD_2()
+    {
+        const string reference = "QUOTE-WITH-CLAIM";
+        var sold = new SellPolicyRequestBuilder(reference).WithStartDate(TestClock.Today).WithAmount(476.25m).WithPaymentMethod("Card").Build();
+        using var client = _factory.CreateClient();
+        await client.SellAndReadBack(sold, reference);
+        var claimReference = ClaimAssert.IsClaim(
+            await client.RecordClaim(reference, new ClaimRequestBuilder().WithDescription("Cracked bathroom basin").Build()),
+            reference, TestClock.Today, "Cracked bathroom basin");
+
+        var quote = await client.Quote(reference, new DateOnly(2026, 10, 20));
+
+        CancellationAssert.IsQuote(quote, new ExpectedCancellation(
+            reference, new DateOnly(2026, 10, 20), "COULD-2", "0.00",
+            [new ExpectedTerm(1, "COULD-2", 365, 4, 361, "0.00")],
+            []), TestClock.Today);
+        PolicyStateAssert.ReadsBack(
+            await client.ReadBack(reference), sold, reference, TodayStartEnd, "Active", true, null, [],
+            [new ExpectedClaim(claimReference, TestClock.Today, "Cracked bathroom basin")]);
+    }
+
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    public async Task Quote_without_a_cancellationDate_is_rejected_with_400()
+    {
+        await AssertQuoteShape("QUOTE-NO-DATE", string.Empty, "cancellationDate");
+    }
+
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    public async Task Quote_with_a_cancellationDate_not_in_yyyy_MM_dd_is_rejected_with_400()
+    {
+        await AssertQuoteShape("QUOTE-BAD-FORMAT", "cancellationDate=11/30/2026", "cancellationDate");
+    }
+
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    public async Task Quote_with_a_cancellationDate_that_is_not_a_calendar_date_is_rejected_with_400()
+    {
+        await AssertQuoteShape("QUOTE-NOT-A-DATE", "cancellationDate=2027-02-30", "cancellationDate");
+    }
+
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    public async Task Quote_with_an_unknown_query_parameter_is_rejected_with_400()
+    {
+        await AssertQuoteShape("QUOTE-TYPO", "cancellationDate=2026-11-30&cancelationDate=2026-11-30", "cancelationDate");
+    }
+
+    // reference is bound from the route, never the query, so as a query key it is unknown (finding F2 A2/I4).
+    [Fact]
+    [Trait("Rule", "COULD-1")]
+    public async Task Quote_with_a_reference_query_parameter_is_rejected_with_400()
+    {
+        await AssertQuoteShape("QUOTE-REF-KEY", "cancellationDate=2026-11-30&reference=OTHER-REF", "reference");
+    }
+
+    [Fact]
+    [Trait("Rule", "GET-1")]
+    public async Task Quote_for_an_unknown_reference_answers_404()
+    {
+        using var client = _factory.CreateClient();
+
+        using var response = await client.GetQuote("QUOTE-NO-SUCH", new DateOnly(2026, 11, 30));
+
+        await ProblemAssert.NotFound(response, PolicyActions.QuotePath("QUOTE-NO-SUCH"), "QUOTE-NO-SUCH");
+    }
+
+    private async Task AssertQuote(
+        string reference,
+        JsonObject sold,
+        DateOnly expectedEnd,
+        string expectedStatus,
+        DateOnly cancellationDate,
+        string expectedRule,
+        int daysInTerm,
+        int daysUsed,
+        int unusedDays,
+        string refund,
+        string refundType,
+        DateOnly? quotedOn = null)
+    {
+        using var client = _factory.CreateClient();
+        var paymentReference = (await client.SellAndReadBack(sold, reference)).PaymentReference();
+
+        var quote = await client.Quote(reference, cancellationDate);
+
+        CancellationAssert.IsQuote(quote, new ExpectedCancellation(
+            reference, cancellationDate, expectedRule, refund,
+            [new ExpectedTerm(1, expectedRule, daysInTerm, daysUsed, unusedDays, refund)],
+            [new ExpectedRefund(refundType, refund, paymentReference)]), quotedOn ?? TestClock.Today);
+        PolicyStateAssert.ReadsBackUnchanged(await client.ReadBack(reference), sold, reference, expectedEnd, expectedStatus);
+    }
+
+    // A sold policy, then a quote whose query is malformed: 400 with the key in errors, and nothing changed.
+    private async Task AssertQuoteShape(string reference, string query, string errorKey)
+    {
+        var sold = new SellPolicyRequestBuilder(reference).Build();
+        using var client = _factory.CreateClient();
+        await client.SellAndReadBack(sold, reference);
+
+        using var response = await client.GetQuote(reference, query);
+
+        ProblemAssert.HasError(await ProblemAssert.ValidationErrors(response, PolicyActions.QuotePath(reference)), errorKey);
+        PolicyStateAssert.ReadsBackUnchanged(await client.ReadBack(reference), sold, reference, FutureStartEnd, "Pending");
+    }
+
+    private static async Task<string> ReadBackText(HttpClient client, string reference)
+    {
+        using var read = await client.GetPolicy(reference);
+        Assert.Equal(HttpStatusCode.OK, read.StatusCode);
+        return await read.Content.ReadAsStringAsync(TestContext.Current.CancellationToken);
+    }
+}
diff --git a/tests/Uinsure.Policies.Api.Tests/ClaimCoverTests.cs b/tests/Uinsure.Policies.Api.Tests/ClaimCoverTests.cs
