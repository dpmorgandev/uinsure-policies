@@ -0,0 +1,25 @@
+using System.Text.Json;
+using Xunit;
+
+namespace Uinsure.Policies.Api.Tests.Support;
+
+// The E5 ClaimResponse, member for member. Returns the claim's generated reference, for the read-back to match.
+internal static class ClaimAssert
+{
+    private static readonly string[] ClaimMembers = ["reference", "policyReference", "claimDate", "description", "hasClaims"];
+
+    public static string IsClaim(JsonElement body, string policyReference, DateOnly claimDate, string? description)
+    {
+        PolicyResponseAssert.HasMembers(body, ClaimMembers, "claim");
+        var reference = body.Member("reference").GetString();
+        Assert.False(string.IsNullOrWhiteSpace(reference));
+        Assert.NotEqual(policyReference, reference);
+        Assert.Equal(policyReference, body.Member("policyReference").GetString());
+        Assert.Equal(claimDate, body.GetDate("claimDate"));
+        Assert.Equal(description, body.Member("description").GetString());
+
+        // COULD-2: any claim sets the policy's hasClaims.
+        Assert.True(body.Member("hasClaims").GetBoolean());
+        return reference;
+    }
+}
diff --git a/tests/Uinsure.Policies.Api.Tests/Support/ConcurrentWriteApiFactory.cs b/tests/Uinsure.Policies.Api.Tests/Support/ConcurrentWriteApiFactory.cs
new file mode 100644
index 0000000..b4eaa5e
--- /dev/null
+++ b/tests/Uinsure.Policies.Api.Tests/Support/ConcurrentWriteApiFactory.cs
@@ -0,0 +1,88 @@
+using System.Collections.Concurrent;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.TestHost;
+using Microsoft.EntityFrameworkCore.ChangeTracking;
+using Microsoft.Extensions.DependencyInjection;
+using Uinsure.Policies.Domain.Policies;
+using Uinsure.Policies.Persistence;
+using Uinsure.Policies.Services;
+
+namespace Uinsure.Policies.Api.Tests.Support;
+
+// The API with a lost race on demand, through the real F3 endpoints. A test arms a reference
+// (LoseTheNextSaveOf); the next request that loaded that policy and then saves it finds that another request
+// saved the same policy first, between its load and its save. The app's IPolicyRepository is wrapped so the
+// other request runs at exactly that point: it loads the policy in a scope of its own and saves it with a new
+// Version (a literal, never Guid.NewGuid()). The armed request's save then still carries the Version it
+// loaded, so the repository raises PersistenceConflictException(Concurrency) and the app answers 409.
+public sealed class ConcurrentWriteApiFactory : PoliciesApiFactory
+{
+    private static readonly Guid OtherRequestVersion = new("0f3c0000-0000-4000-8000-000000000003");
+
+    private readonly ConcurrentDictionary<string, bool> _armed = new(StringComparer.Ordinal);
+
+    public void LoseTheNextSaveOf(string reference) => _armed[reference] = true;
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        base.ConfigureWebHost(builder);
+
+        builder.ConfigureTestServices(services =>
+        {
+            var registered = services.Single(descriptor => descriptor.ServiceType == typeof(IPolicyRepository));
+            services.Remove(registered);
+            services.AddScoped<IPolicyRepository>(provider => new RacedRepository(AppRepository(provider, registered), provider, this));
+        });
+    }
+
+    private static IPolicyRepository AppRepository(IServiceProvider provider, ServiceDescriptor registered) =>
+        registered.ImplementationFactory is not null
+            ? (IPolicyRepository)registered.ImplementationFactory(provider)
+            : (IPolicyRepository)ActivatorUtilities.CreateInstance(provider, registered.ImplementationType!);
+
+    private bool Disarm(PolicyReference reference) => _armed.TryRemove(reference.Value, out _);
+
+    // The other request: load the same policy and save it with a new Version, before the armed request saves.
+    private static async Task SaveFromAnotherRequest(IServiceProvider provider, PolicyReference reference, CancellationToken ct)
+    {
+        using var other = provider.GetRequiredService<IServiceScopeFactory>().CreateScope();
+        var context = other.ServiceProvider.GetRequiredService<PoliciesDbContext>();
+        _ = await other.ServiceProvider.GetRequiredService<IPolicyRepository>().GetByReference(reference, ct);
+        VersionedEntry(context).Property("Version").CurrentValue = OtherRequestVersion;
+        await context.SaveChangesAsync(ct);
+    }
+
+    private static EntityEntry VersionedEntry(PoliciesDbContext context) =>
+        context.ChangeTracker.Entries().Single(entry => entry.Metadata.FindProperty("Version")?.IsConcurrencyToken == true);
+
+    private sealed class RacedRepository(IPolicyRepository app, IServiceProvider provider, ConcurrentWriteApiFactory factory) : IPolicyRepository
+    {
+        private readonly List<PolicyReference> _loaded = [];
+
+        public async Task<Policy?> GetByReference(PolicyReference reference, CancellationToken ct)
+        {
+            var policy = await app.GetByReference(reference, ct);
+            if (policy is not null)
+            {
+                _loaded.Add(reference);
+            }
+
+            return policy;
+        }
+
+        public void Add(Policy policy) => app.Add(policy);
+
+        public async Task SaveChanges(CancellationToken ct)
+        {
+            foreach (var reference in _loaded.ToArray())
+            {
+                if (factory.Disarm(reference))
+                {
+                    await SaveFromAnotherRequest(provider, reference, ct);
+                }
+            }
+
+            await app.SaveChanges(ct);
+        }
+    }
+}
diff --git a/tests/Uinsure.Policies.Api.Tests/Support/OneTermCancellation.cs b/tests/Uinsure.Policies.Api.Tests/Support/OneTermCancellation.cs
new file mode 100644
index 0000000..0964fa0
--- /dev/null
+++ b/tests/Uinsure.Policies.Api.Tests/Support/OneTermCancellation.cs
@@ -0,0 +1,40 @@
+using System.Text.Json.Nodes;
+using Xunit;
+
+namespace Uinsure.Policies.Api.Tests.Support;
+
+// A one-term policy's cancellation, asserted end to end: the E3 201 body (the rule applied, the day counts and
+// the refund, each the test's literal) and then the E2 read-back (Cancelled, with the cancellation and the
+// refund stored, the refund reversing the sold payment). refundType null means a £0 refund: no Refund record,
+// so refunds[] is empty in both.
+internal static class OneTermCancellation
+{
+    public static async Task AssertCancelledAndReadBack(
+        HttpClient client,
+        HttpResponseMessage response,
+        string reference,
+        JsonObject sold,
+        DateOnly expectedEnd,
+        string paymentReference,
+        DateOnly expectedDate,
+        string expectedRule,
+        int daysInTerm,
+        int daysUsed,
+        int unusedDays,
+        string refund,
+        string? refundType)
+    {
+        var body = await PolicyActions.CancelledBody(response);
+
+        ExpectedRefund[] refunds = refundType is null ? [] : [new(refundType, refund, paymentReference)];
+        var refundReferences = CancellationAssert.IsCancellation(body, new ExpectedCancellation(
+            reference, expectedDate, expectedRule, refund,
+            [new ExpectedTerm(1, expectedRule, daysInTerm, daysUsed, unusedDays, refund)],
+            refunds));
+
+        ExpectedPolicyRefund[] stored = refundType is null ? [] : [new(Assert.Single(refundReferences), refundType, refund, paymentReference)];
+        PolicyStateAssert.ReadsBack(
+            await client.ReadBack(reference), sold, reference, expectedEnd, "Cancelled", false,
+            new ExpectedCancellationSummary(expectedDate, expectedRule, refund), stored, []);
+    }
+}
diff --git a/tests/Uinsure.Policies.Api.Tests/Support/PolicyActions.cs b/tests/Uinsure.Policies.Api.Tests/Support/PolicyActions.cs
new file mode 100644
index 0000000..72aa5c0
--- /dev/null
+++ b/tests/Uinsure.Policies.Api.Tests/Support/PolicyActions.cs
@@ -0,0 +1,103 @@
+using System.Net;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using Xunit;
+
+namespace Uinsure.Policies.Api.Tests.Support;
+
+// HTTP helpers for the F3 routes: E3 POST /policies/{reference}/cancellation, E4 GET
+// /policies/{reference}/cancellation-quote?cancellationDate= and E5 POST /policies/{reference}/claims.
+// The Cancel and RecordClaim helpers assert the success status (201) and the Location rule of each route;
+// the test then reads the policy back over GET and asserts it in full.
+internal static class PolicyActions
+{
+    public static string CancellationPath(string reference) => $"/policies/{reference}/cancellation";
+
+    public static string QuotePath(string reference) => $"/policies/{reference}/cancellation-quote";
+
+    public static string ClaimsPath(string reference) => $"/policies/{reference}/claims";
+
+    public static Task<HttpResponseMessage> PostCancellation(this HttpClient client, string reference, JsonObject body) =>
+        client.PostJson(CancellationPath(reference), body.ToJsonString());
+
+    // Raw text, so a test can send JSON that no JsonObject can represent (malformed, an empty string).
+    public static Task<HttpResponseMessage> PostCancellation(this HttpClient client, string reference, string json) =>
+        client.PostJson(CancellationPath(reference), json);
+
+    // No body and no Content-Type at all: the optional body of CANCEL-3.
+    public static Task<HttpResponseMessage> PostCancellationWithNoBody(this HttpClient client, string reference) =>
+        client.PostAsync(CancellationPath(reference), content: null, TestContext.Current.CancellationToken);
+
+    public static Task<HttpResponseMessage> GetQuote(this HttpClient client, string reference, DateOnly cancellationDate) =>
+        client.GetQuote(reference, "cancellationDate=" + cancellationDate.Iso());
+
+    // The query string as sent (without the "?"), so a shape test can leave the date out or misspell it.
+    public static Task<HttpResponseMessage> GetQuote(this HttpClient client, string reference, string query) =>
+        client.GetAsync(query.Length == 0 ? QuotePath(reference) : $"{QuotePath(reference)}?{query}", TestContext.Current.CancellationToken);
+
+    public static Task<HttpResponseMessage> PostClaim(this HttpClient client, string reference, JsonObject body) =>
+        client.PostJson(ClaimsPath(reference), body.ToJsonString());
+
+    public static Task<HttpResponseMessage> PostClaim(this HttpClient client, string reference, string json) =>
+        client.PostJson(ClaimsPath(reference), json);
+
+    // E3 → 201 with the CancellationResponse body and no Location (api.md E3). Returns the body.
+    public static async Task<JsonElement> Cancel(this HttpClient client, string reference, JsonObject body)
+    {
+        using var response = await client.PostCancellation(reference, body);
+        return await CancelledBody(response);
+    }
+
+    public static async Task<JsonElement> CancelledBody(HttpResponseMessage response)
+    {
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        Assert.Null(response.Headers.Location);
+        return await response.ReadJson();
+    }
+
+    // E4 → 200 with the CancellationQuoteResponse body. Returns the body.
+    public static async Task<JsonElement> Quote(this HttpClient client, string reference, DateOnly cancellationDate)
+    {
+        using var response = await client.GetQuote(reference, cancellationDate);
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        return await response.ReadJson();
+    }
+
+    // E5 → 201 with Location /policies/{reference} and the ClaimResponse body. Returns the body.
+    public static async Task<JsonElement> RecordClaim(this HttpClient client, string reference, JsonObject body)
+    {
+        using var response = await client.PostClaim(reference, body);
+        return await ClaimedBody(response, reference);
+    }
+
+    public static async Task<JsonElement> ClaimedBody(HttpResponseMessage response, string reference)
+    {
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        Assert.Equal($"/policies/{reference}", response.LocationPath());
+        return await response.ReadJson();
+    }
+
+    // GET /policies/{reference} → 200, the policy as stored now.
+    public static async Task<JsonElement> ReadBack(this HttpClient client, string reference)
+    {
+        using var read = await client.GetPolicy(reference);
+        Assert.Equal(HttpStatusCode.OK, read.StatusCode);
+        return await read.ReadJson();
+    }
+
+    // The reference of the one payment a sold policy has (SELL-6), which its refund must reverse (CANCEL-2).
+    public static string PaymentReference(this JsonElement policy)
+    {
+        var payment = Assert.Single(policy.Member("payments").EnumerateArray());
+        var reference = payment.Member("reference").GetString();
+        Assert.False(string.IsNullOrWhiteSpace(reference));
+        return reference;
+    }
+
+    private static async Task<HttpResponseMessage> PostJson(this HttpClient client, string path, string json)
+    {
+        using var content = new StringContent(json, Encoding.UTF8, "application/json");
+        return await client.PostAsync(path, content, TestContext.Current.CancellationToken);
+    }
+}
