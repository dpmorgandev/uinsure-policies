+++ b/tests/Uinsure.Policies.Services.Tests/Support/SequentialReferenceGenerator.cs
@@ -0,0 +1,14 @@
+namespace Uinsure.Policies.Services.Tests.Support;
+
+// A reference generator with predictable output: PAY-SVC-1, PAY-SVC-2, … and REF-SVC-1, REF-SVC-2, …
+// Each call is counted, so a test can see which references the service asked the seam for.
+internal sealed class SequentialReferenceGenerator : IReferenceGenerator
+{
+    public int PaymentCalls { get; private set; }
+
+    public int RefundCalls { get; private set; }
+
+    public string Payment() => $"PAY-SVC-{++PaymentCalls}";
+
+    public string Refund() => $"REF-SVC-{++RefundCalls}";
+}
diff --git a/tests/Uinsure.Policies.Services.Tests/Support/StoredPolicyRepository.cs b/tests/Uinsure.Policies.Services.Tests/Support/StoredPolicyRepository.cs
new file mode 100644
index 0000000..ccb00ed
--- /dev/null
+++ b/tests/Uinsure.Policies.Services.Tests/Support/StoredPolicyRepository.cs
@@ -0,0 +1,29 @@
+using Uinsure.Policies.Domain.Policies;
+
+namespace Uinsure.Policies.Services.Tests.Support;
+
+// A repository that already holds one policy, as the database does after a sale. GetByReference hands back
+// that same instance for its reference (and nothing for any other), so a test sees what the service did to it.
+// Every call is counted, so a test can see whether the service saved.
+internal sealed class StoredPolicyRepository(Policy stored) : IPolicyRepository
+{
+    public int GetByReferenceCalls { get; private set; }
+
+    public int AddCalls { get; private set; }
+
+    public int SaveChangesCalls { get; private set; }
+
+    public Task<Policy?> GetByReference(PolicyReference reference, CancellationToken ct)
+    {
+        GetByReferenceCalls++;
+        return Task.FromResult(stored.Reference == reference ? stored : null);
+    }
+
+    public void Add(Policy policy) => AddCalls++;
+
+    public Task SaveChanges(CancellationToken ct)
+    {
+        SaveChangesCalls++;
+        return Task.CompletedTask;
+    }
+}
