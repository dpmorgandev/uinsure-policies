diff --git a/tests/Uinsure.Policies.Services.Tests/PolicyServiceRenewPaymentTests.cs b/tests/Uinsure.Policies.Services.Tests/PolicyServiceRenewPaymentTests.cs
new file mode 100644
index 0000000..316c189
