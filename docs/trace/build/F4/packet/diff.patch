@@ -0,0 +1,114 @@
+using Uinsure.Policies.Api.Tests.Builders;
+using Uinsure.Policies.Api.Tests.Support;
+using Xunit;
+
+namespace Uinsure.Policies.Api.Tests;
+
+// RENEW-3a: renewing an auto-renewing policy creates a payment for the new term's amount, by the request's
+// paymentMethod, or, when none is sent, by the current term's payment method. The payment has a generated
+// reference of its own, which the new term links to; term 1's payment is unchanged. Each policy is sold (E1)
+// with auto-renew on, the clock is moved into its renewal window, and the renewal (E6) is read back whole (E2):
+//   start 2026-11-19 ends 2027-11-18; term 2 2027-11-19 to 2028-11-18;
+//   start 2026-12-10 ends 2027-12-09; term 2 2027-12-10 to 2028-12-09;
+//   start 2026-11-25 ends 2027-11-24; term 2 2027-11-25 to 2028-11-24;
+//   start 2026-10-23 ends 2027-10-22; term 2 2027-10-23 to 2028-10-22.
+// The default taken from a renewed term rather than the first is RenewTermTests' third-term row.
+public sealed class RenewPaymentTests : IClassFixture<PoliciesApiFactory>
+{
+    private readonly PoliciesApiFactory _factory;
+
+    public RenewPaymentTests(PoliciesApiFactory factory)
+    {
+        _factory = factory;
+        _factory.ResetClock();
+    }
+
+    [Fact]
+    [Trait("Rule", "RENEW-3a")]
+    public async Task Auto_renewal_without_a_payment_method_is_paid_by_the_current_terms_Direct_Debit()
+    {
+        const string reference = "RENEW3A-DEFAULT-DD";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(new DateOnly(2026, 11, 19)).WithAmount(538.46m).WithPaymentMethod("DirectDebit").Build();
+        using var client = _factory.CreateClient();
+        var sale = await client.SellAndReadBack(sold, reference);
+        _factory.MoveClockTo(new DateOnly(2027, 11, 5));
+
+        await client.RenewAndReadBack(
+            reference,
+            new RenewalRequestBuilder().WithAmount(557.09m).Build(),
+            sold,
+            new ExpectedRenewedPolicy(reference, "Active", 1, [
+                new ExpectedPolicyTerm(new DateOnly(2026, 11, 19), new DateOnly(2027, 11, 18), "538.46", "DirectDebit"),
+                new ExpectedPolicyTerm(new DateOnly(2027, 11, 19), new DateOnly(2028, 11, 18), "557.09", "DirectDebit"),
+            ]),
+            [sale.PaymentReference()]);
+    }
+
+    [Fact]
+    [Trait("Rule", "RENEW-3a")]
+    public async Task Auto_renewal_without_a_payment_method_is_paid_by_the_current_terms_Card()
+    {
+        const string reference = "RENEW3A-DEFAULT-CARD";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(new DateOnly(2026, 12, 10)).WithAmount(611.72m).WithPaymentMethod("Card").Build();
+        using var client = _factory.CreateClient();
+        var sale = await client.SellAndReadBack(sold, reference);
+        _factory.MoveClockTo(new DateOnly(2027, 11, 25));
+
+        await client.RenewAndReadBack(
+            reference,
+            new RenewalRequestBuilder().WithAmount(634.05m).Build(),
+            sold,
+            new ExpectedRenewedPolicy(reference, "Active", 1, [
+                new ExpectedPolicyTerm(new DateOnly(2026, 12, 10), new DateOnly(2027, 12, 9), "611.72", "Card"),
+                new ExpectedPolicyTerm(new DateOnly(2027, 12, 10), new DateOnly(2028, 12, 9), "634.05", "Card"),
+            ]),
+            [sale.PaymentReference()]);
+    }
+
+    [Fact]
+    [Trait("Rule", "RENEW-3a")]
+    public async Task Auto_renewal_with_Card_on_a_Direct_Debit_policy_is_paid_by_Card()
+    {
+        const string reference = "RENEW3A-REQUEST-CARD";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(new DateOnly(2026, 11, 25)).WithAmount(492.38m).WithPaymentMethod("DirectDebit").Build();
+        using var client = _factory.CreateClient();
+        var sale = await client.SellAndReadBack(sold, reference);
+        _factory.MoveClockTo(new DateOnly(2027, 11, 15));
+
+        await client.RenewAndReadBack(
+            reference,
+            new RenewalRequestBuilder().WithAmount(515.60m).WithPaymentMethod("Card").Build(),
+            sold,
+            new ExpectedRenewedPolicy(reference, "Active", 1, [
+                new ExpectedPolicyTerm(new DateOnly(2026, 11, 25), new DateOnly(2027, 11, 24), "492.38", "DirectDebit"),
+                new ExpectedPolicyTerm(new DateOnly(2027, 11, 25), new DateOnly(2028, 11, 24), "515.60", "Card"),
+            ]),
+            [sale.PaymentReference()]);
+    }
+
+    // The amount is sent as 390, a whole number of pounds, and written back as 390.00 in the term and its payment.
+    [Fact]
+    [Trait("Rule", "RENEW-3a")]
+    public async Task Auto_renewal_with_Direct_Debit_on_a_Card_policy_is_paid_by_Direct_Debit()
+    {
+        const string reference = "RENEW3A-REQUEST-DD";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(new DateOnly(2026, 10, 23)).WithAmount(377.14m).WithPaymentMethod("Card").Build();
+        using var client = _factory.CreateClient();
+        var sale = await client.SellAndReadBack(sold, reference);
+        _factory.MoveClockTo(new DateOnly(2027, 10, 1));
+
+        await client.RenewAndReadBack(
+            reference,
+            new RenewalRequestBuilder().WithAmount(390m).WithPaymentMethod("DirectDebit").Build(),
+            sold,
+            new ExpectedRenewedPolicy(reference, "Active", 1, [
+                new ExpectedPolicyTerm(new DateOnly(2026, 10, 23), new DateOnly(2027, 10, 22), "377.14", "Card"),
+                new ExpectedPolicyTerm(new DateOnly(2027, 10, 23), new DateOnly(2028, 10, 22), "390.00", "DirectDebit"),
+            ]),
+            [sale.PaymentReference()]);
+    }
+}
diff --git a/tests/Uinsure.Policies.Api.Tests/RenewShapeTests.cs b/tests/Uinsure.Policies.Api.Tests/RenewShapeTests.cs
new file mode 100644
index 0000000..c0b0efe
--- /dev/null
+++ b/tests/Uinsure.Policies.Api.Tests/RenewShapeTests.cs
@@ -0,0 +1,134 @@
+using Uinsure.Policies.Api.Tests.Builders;
+using Uinsure.Policies.Api.Tests.Support;
+using Xunit;
+
+namespace Uinsure.Policies.Api.Tests;
+
+// E6, the shape of the renewal body. amount is required, a JSON number with at most 2 decimal places and at most
+// 1,000,000.00 (H6); paymentMethod, when sent, is one of the PaymentMethod names, never an integer; no other
+// member exists (a renewal cannot choose its own start date: RENEW-4). Each failure is a 400
+// ValidationProblemDetails with no ruleId, returned before any rule, at /policies/{reference}/renewals, and the
+// policy reads back as sold. Each policy is the builder's default sale:
+//   start 2026-11-08 ends 2027-11-07, Pending on 2026-10-17.
+public sealed class RenewShapeTests : IClassFixture<PoliciesApiFactory>
+{
+    private static readonly DateOnly DefaultEnd = new(2027, 11, 7);
+
+    private readonly PoliciesApiFactory _factory;
+
+    public RenewShapeTests(PoliciesApiFactory factory)
+    {
+        _factory = factory;
+        _factory.ResetClock();
+    }
+
+    [Fact]
+    [Trait("Rule", "RENEW-5")]
+    public async Task Renewal_without_an_amount_is_rejected_with_400()
+    {
+        await AssertShape("RENEW-SHAPE-NO-AMT", new RenewalRequestBuilder().WithoutAmount().Build().ToJsonString(), "amount");
+    }
+
+    [Fact]
+    [Trait("Rule", "RENEW-5")]
+    public async Task Renewal_with_a_null_amount_is_rejected_with_400()
+    {
+        var body = new RenewalRequestBuilder().Build();
+        body["amount"] = null;
+
+        await AssertShape("RENEW-SHAPE-NULL-AMT", body.ToJsonString(), "amount");
+    }
+
+    [Fact]
+    [Trait("Rule", "RENEW-5")]
+    public async Task Renewal_amount_with_3_decimal_places_is_rejected_with_400()
+    {
+        await AssertShape("RENEW-SHAPE-3DP", new RenewalRequestBuilder().WithAmount(432.105m).Build().ToJsonString(), "amount");
+    }
+
+    [Fact]
+    [Trait("Rule", "RENEW-5")]
+    public async Task Renewal_amount_of_1_000_000_01_is_rejected_with_400()
+    {
+        await AssertShape("RENEW-SHAPE-1M-01", new RenewalRequestBuilder().WithAmount(1_000_000.01m).Build().ToJsonString(), "amount");
+    }
+
+    [Fact]
+    [Trait("Rule", "RENEW-5")]
+    public async Task Renewal_amount_sent_as_a_string_is_rejected_with_400()
+    {
+        var body = new RenewalRequestBuilder().Build();
+        body["amount"] = "603.27";
+
+        await AssertShape("RENEW-SHAPE-AMT-TEXT", body.ToJsonString(), "$.amount");
+    }
+
+    [Fact]
+    [Trait("Rule", "RENEW-3a")]
+    public async Task Renewal_with_an_unknown_payment_method_is_rejected_with_400()
+    {
+        await AssertShape("RENEW-SHAPE-METHOD", new RenewalRequestBuilder().WithPaymentMethod("PayPal").Build().ToJsonString(), "$.paymentMethod");
+    }
+
+    [Fact]
+    [Trait("Rule", "RENEW-3a")]
+    public async Task Renewal_with_an_integer_payment_method_is_rejected_with_400()
+    {
+        var body = new RenewalRequestBuilder().Build();
+        body["paymentMethod"] = 1;
+
+        await AssertShape("RENEW-SHAPE-INT-METH", body.ToJsonString(), "$.paymentMethod");
+    }
+
+    [Fact]
+    [Trait("Rule", "RENEW-4")]
+    public async Task Renewal_with_a_startDate_as_an_unknown_field_is_rejected_with_400()
+    {
+        var body = new RenewalRequestBuilder().Build();
+        body["startDate"] = "2027-11-08";
+
+        await AssertShape("RENEW-SHAPE-UNKNOWN", body.ToJsonString(), "$.startDate");
+    }
+
+    [Fact]
+    [Trait("Rule", "RENEW-4")]
+    public async Task Renewal_with_malformed_JSON_is_rejected_with_400()
+    {
+        await AssertShape("RENEW-SHAPE-BAD-JSON", "{\"amount\": 603.27", errorKey: null);
+    }
+
+    [Fact]
+    [Trait("Rule", "RENEW-4")]
+    public async Task Renewal_with_no_body_is_rejected_with_400()
+    {
+        const string reference = "RENEW-SHAPE-NO-BODY";
+        var sold = new SellPolicyRequestBuilder(reference).Build();
+        using var client = _factory.CreateClient();
+        await client.SellAndReadBack(sold, reference);
+
+        using var response = await client.PostRenewalWithNoBody(reference);
+
+        var errors = await ProblemAssert.ValidationErrors(response, RenewalActions.RenewalsPath(reference));
+        // QA step 34: one entry, keyed camelCase as every other E6 shape error ("amount", not "Amount").
+        Assert.Equal(["amount"], errors.EnumerateObject().Select(entry => entry.Name).ToArray());
+        PolicyStateAssert.ReadsBackUnchanged(await client.ReadBack(reference), sold, reference, DefaultEnd, "Pending");
+    }
+
+    // errorKey null: malformed JSON, whose errors entry the JSON reader names.
+    private async Task AssertShape(string reference, string json, string? errorKey)
+    {
+        var sold = new SellPolicyRequestBuilder(reference).Build();
+        using var client = _factory.CreateClient();
+        await client.SellAndReadBack(sold, reference);
+
+        using var response = await client.PostRenewal(reference, json);
+
+        var errors = await ProblemAssert.ValidationErrors(response, RenewalActions.RenewalsPath(reference));
+        if (errorKey is not null)
+        {
+            ProblemAssert.HasError(errors, errorKey);
+        }
+
+        PolicyStateAssert.ReadsBackUnchanged(await client.ReadBack(reference), sold, reference, DefaultEnd, "Pending");
+    }
+}
diff --git a/tests/Uinsure.Policies.Api.Tests/RenewTermTests.cs b/tests/Uinsure.Policies.Api.Tests/RenewTermTests.cs
new file mode 100644
index 0000000..0f3699f
--- /dev/null
+++ b/tests/Uinsure.Policies.Api.Tests/RenewTermTests.cs
@@ -0,0 +1,185 @@
+using Uinsure.Policies.Api.Tests.Builders;
+using Uinsure.Policies.Api.Tests.Support;
+using Xunit;
+
+namespace Uinsure.Policies.Api.Tests;
+
+// RENEW-4: a renewal appends the next term under the same reference, starting the day after the latest term's
+// end; the earlier terms are kept as they were. E6 answers 201 with Location /policies/{reference} and the
+// PolicyResponse, and the GET read-back is asserted whole (RenewedPolicyAssert). The renewal window is measured
+// from the latest term's end (RENEW-1/2), so a policy renewed once cannot be renewed again until the window of
+// its new term opens. Each policy is sold (E1) with the clock at TestClock.Now and then renewed later; every
+// date is a literal:
+//   start 2026-11-30 ends 2027-11-29; term 2 2027-11-30 to 2028-11-29;
+//   start 2026-11-21 ends 2027-11-20; term 2 2027-11-21 to 2028-11-20;
+//   start 2026-12-05 ends 2027-12-04; term 2 2027-12-05 to 2028-12-04, whose window is 2028-11-04 to 2028-12-04;
+//   start 2026-11-12 ends 2027-11-11; term 2 2027-11-12 to 2028-11-11; term 3 2028-11-12 to 2029-11-11;
+//   start 2026-12-01 ends 2027-11-30; term 2 2027-12-01 to 2028-11-30.
+public sealed class RenewTermTests : IClassFixture<PoliciesApiFactory>
+{
+    private readonly PoliciesApiFactory _factory;
+
+    public RenewTermTests(PoliciesApiFactory factory)
+    {
+        _factory = factory;
+        _factory.ResetClock();
+    }
+
+    [Fact]
+    [Trait("Rule", "RENEW-4")]
+    public async Task Renewal_appends_term_2_from_the_day_after_term_1_ends_under_the_same_reference()
+    {
+        const string reference = "RENEW4-APPEND";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithType("BuyToLet")
+            .WithStartDate(new DateOnly(2026, 11, 30))
+            .WithAmount(562.91m)
+            .WithPaymentMethod("DirectDebit")
+            .WithPolicyholders(
+                new PolicyholderBuilder().WithName("Dorothy", "Vaughan").WithDateOfBirth(new DateOnly(1979, 9, 20)),
+                new PolicyholderBuilder().WithName("Mary", "Winston").WithDateOfBirth(new DateOnly(1983, 2, 14)))
+            .WithAddress("12 Oldham St", null, "Northern Quarter")
+            .WithPostcode("M1 1JQ")
+            .Build();
+        using var client = _factory.CreateClient();
+        var sale = await client.SellAndReadBack(sold, reference);
+        _factory.MoveClockTo(new DateOnly(2027, 11, 10));
+
+        await client.RenewAndReadBack(
+            reference,
+            new RenewalRequestBuilder().WithAmount(588.04m).WithPaymentMethod("Card").Build(),
+            sold,
+            new ExpectedRenewedPolicy(reference, "Active", 1, [
+                new ExpectedPolicyTerm(new DateOnly(2026, 11, 30), new DateOnly(2027, 11, 29), "562.91", "DirectDebit"),
+                new ExpectedPolicyTerm(new DateOnly(2027, 11, 30), new DateOnly(2028, 11, 29), "588.04", "Card"),
+            ]),
+            [sale.PaymentReference()]);
+    }
+
+    // On the renewed term's first day it is the current term: the policy-level dates and amount are term 2's.
+    [Fact]
+    [Trait("Rule", "RENEW-4")]
+    public async Task Renewed_policy_shows_term_2_as_current_from_its_start_date()
+    {
+        const string reference = "RENEW4-TERM2-CURRENT";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(new DateOnly(2026, 11, 21)).WithAmount(509.33m).WithPaymentMethod("Card").Build();
+        ExpectedPolicyTerm[] terms =
+        [
+            new(new DateOnly(2026, 11, 21), new DateOnly(2027, 11, 20), "509.33", "Card"),
+            new(new DateOnly(2027, 11, 21), new DateOnly(2028, 11, 20), "534.80", "DirectDebit"),
+        ];
+        using var client = _factory.CreateClient();
+        var sale = await client.SellAndReadBack(sold, reference);
+        _factory.MoveClockTo(new DateOnly(2027, 11, 1));
+        var paymentReferences = await client.RenewAndReadBack(
+            reference,
+            new RenewalRequestBuilder().WithAmount(534.80m).WithPaymentMethod("DirectDebit").Build(),
+            sold,
+            new ExpectedRenewedPolicy(reference, "Active", 1, terms),
+            [sale.PaymentReference()]);
+
+        _factory.MoveClockTo(new DateOnly(2027, 11, 21));
+
+        RenewedPolicyAssert.ReadsBack(
+            await client.ReadBack(reference), sold, new ExpectedRenewedPolicy(reference, "Active", 2, terms), paymentReferences);
+    }
+
+    // Renewed on 2027-11-20, the latest term is now term 2, ending 2028-12-04: a second renewal the same day is
+    // a year before that term's window and is rejected, and the policy keeps its two terms.
+    [Fact]
+    [Trait("Rule", "RENEW-4")]
+    [Trait("Rule", "RENEW-1")]
+    public async Task Second_renewal_on_the_same_day_is_outside_the_window_of_the_latest_term()
+    {
+        const string reference = "RENEW4-LATEST-WINDOW";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(new DateOnly(2026, 12, 5)).WithAmount(473.60m).WithPaymentMethod("DirectDebit").Build();
+        var expected = new ExpectedRenewedPolicy(reference, "Active", 1, [
+            new ExpectedPolicyTerm(new DateOnly(2026, 12, 5), new DateOnly(2027, 12, 4), "473.60", "DirectDebit"),
+            new ExpectedPolicyTerm(new DateOnly(2027, 12, 5), new DateOnly(2028, 12, 4), "497.15", "DirectDebit"),
+        ]);
+        using var client = _factory.CreateClient();
+        var sale = await client.SellAndReadBack(sold, reference);
+        _factory.MoveClockTo(new DateOnly(2027, 11, 20));
+        var paymentReferences = await client.RenewAndReadBack(
+            reference, new RenewalRequestBuilder().WithAmount(497.15m).Build(), sold, expected, [sale.PaymentReference()]);
+
+        using var response = await client.PostRenewal(reference, new RenewalRequestBuilder().WithAmount(501.42m).Build());
+
+        var problem = await ProblemAssert.SingleRuleViolation(response, "RENEW-1/2", "Outside the renewal window", RenewalActions.RenewalsPath(reference));
+        Assert.Equal(new DateOnly(2028, 11, 4), problem.GetDate("windowStart"));
+        Assert.Equal(new DateOnly(2028, 12, 4), problem.GetDate("windowEnd"));
+        RenewedPolicyAssert.ReadsBack(await client.ReadBack(reference), sold, expected, paymentReferences);
+    }
+
+    // Inside term 2's window (2028-10-12 to 2028-11-11) a second renewal appends term 3. With no paymentMethod it
+    // is paid by the current term's method, term 2's Direct Debit, not term 1's Card (RENEW-3a).
+    [Fact]
+    [Trait("Rule", "RENEW-4")]
+    [Trait("Rule", "RENEW-3a")]
+    public async Task Renewal_in_the_window_of_the_renewed_term_appends_term_3_paid_by_the_current_terms_method()
+    {
+        const string reference = "RENEW4-THIRD-TERM";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(new DateOnly(2026, 11, 12)).WithAmount(455.18m).WithPaymentMethod("Card").Build();
+        var term1 = new ExpectedPolicyTerm(new DateOnly(2026, 11, 12), new DateOnly(2027, 11, 11), "455.18", "Card");
+        var term2 = new ExpectedPolicyTerm(new DateOnly(2027, 11, 12), new DateOnly(2028, 11, 11), "468.90", "DirectDebit");
+        using var client = _factory.CreateClient();
+        var sale = await client.SellAndReadBack(sold, reference);
+        _factory.MoveClockTo(new DateOnly(2027, 10, 25));
+        var paymentReferences = await client.RenewAndReadBack(
+            reference,
+            new RenewalRequestBuilder().WithAmount(468.90m).WithPaymentMethod("DirectDebit").Build(),
+            sold,
+            new ExpectedRenewedPolicy(reference, "Active", 1, [term1, term2]),
+            [sale.PaymentReference()]);
+        _factory.MoveClockTo(new DateOnly(2028, 11, 1));
+
+        await client.RenewAndReadBack(
+            reference,
+            new RenewalRequestBuilder().WithAmount(481.27m).Build(),
+            sold,
+            new ExpectedRenewedPolicy(reference, "Active", 2, [
+                term1,
+                term2,
+                new ExpectedPolicyTerm(new DateOnly(2028, 11, 12), new DateOnly(2029, 11, 11), "481.27", "DirectDebit"),
+            ]),
+            paymentReferences);
+    }
+
+    // The route reference is trimmed and upper-cased before the lookup, as on every route; Location names the
+    // normalised reference.
+    [Fact]
+    [Trait("Rule", "RENEW-4")]
+    public async Task Renewal_by_the_lower_case_reference_renews_the_policy()
+    {
+        const string reference = "RENEW4-LOWER";
+        var sold = new SellPolicyRequestBuilder(reference)
+            .WithStartDate(new DateOnly(2026, 12, 1)).WithAmount(471.56m).WithPaymentMethod("Card").Build();
+        using var client = _factory.CreateClient();
+        var sale = await client.SellAndReadBack(sold, reference);
+        _factory.MoveClockTo(new DateOnly(2027, 11, 15));
+
+        await client.RenewAndReadBack(
+            "renew4-lower",
+            new RenewalRequestBuilder().WithAmount(489.67m).Build(),
+            sold,
+            new ExpectedRenewedPolicy(reference, "Active", 1, [
+                new ExpectedPolicyTerm(new DateOnly(2026, 12, 1), new DateOnly(2027, 11, 30), "471.56", "Card"),
+                new ExpectedPolicyTerm(new DateOnly(2027, 12, 1), new DateOnly(2028, 11, 30), "489.67", "Card"),
+            ]),
+            [sale.PaymentReference()]);
+    }
+
+    [Fact]
+    [Trait("Rule", "GET-1")]
+    public async Task Renewal_of_an_unknown_reference_answers_404()
+    {
+        using var client = _factory.CreateClient();
+
+        using var response = await client.PostRenewal("RENEW-NO-SUCH", new RenewalRequestBuilder().Build());
+
+        await ProblemAssert.NotFound(response, RenewalActions.RenewalsPath("RENEW-NO-SUCH"), "RENEW-NO-SUCH");
+    }
+}
diff --git a/tests/Uinsure.Policies.Api.Tests/RenewUnpaidTests.cs b/tests/Uinsure.Policies.Api.Tests/RenewUnpaidTests.cs
