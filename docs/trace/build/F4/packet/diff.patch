+                      "    pm.expect(problem.violations.map(x => x.ruleId)).to.eql(ruleIds);",
+                      "    problem.violations.forEach(x => pm.expect(x.detail).to.be.a('string').and.not.empty);",
+                      "    if (ruleIds.length > 1) { pm.expect(problem.detail).to.eql(ruleIds.length + ' rules failed.'); }",
+                      "    return problem;",
+                      "};",
+                      "// A 400 shape error: ValidationProblemDetails with no ruleId.",
+                      "const shapeProblem = key => {",
+                      "    pm.response.to.have.status(400);",
+                      "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
+                      "    const problem = pm.response.json();",
+                      "    pm.expect(problem.title).to.eql('One or more validation errors occurred.');",
+                      "    pm.expect(problem.instance).to.eql(renewalsPath);",
+                      "    pm.expect(problem.traceId).to.be.a('string').and.not.empty;",
+                      "    pm.expect(problem.ruleId).to.eql(undefined);",
+                      "    if (key) { pm.expect(problem.errors).to.have.property(key); } else { pm.expect(Object.keys(problem.errors)).to.not.be.empty; }",
+                      "};",
+                      "// A rejected renewal adds no term and no payment; the policy reads back as before.",
+                      "const readBack = (rule, cancelled) => pm.sendRequest(v('baseUrl') + policyPath, function (err, res) {",
+                      "    pm.test(rule + ' · read-back has one term and one payment, no renewal', function () {",
+                      "        pm.expect(err).to.eql(null);",
+                      "        pm.expect(res.code).to.eql(200);",
+                      "        const policy = res.json();",
+                      "        pm.expect(policy.terms.length).to.eql(1);",
+                      "        pm.expect(policy.terms[0].startDate).to.eql(v('start'));",
+                      "        pm.expect(policy.terms[0].endDate).to.eql(v('end'));",
+                      "        pm.expect(policy.payments.length).to.eql(1);",
+                      "        if (cancelled) {",
+                      "            pm.expect(policy.status).to.eql('Cancelled');",
+                      "            pm.expect(policy.cancellation).to.not.eql(null);",
+                      "        } else {",
+                      "            pm.expect(policy.cancellation).to.eql(null);",
+                      "        }",
+                      "    });",
+                      "});",
+                      "setupAnswered(\"RENEW-4\", [201]);",
+                      "pm.test(\"RENEW-4 · answers 400 with errors and no ruleId\", function () {",
+                      "    shapeProblem(null);",
+                      "});",
+                      "readBack(\"RENEW-4\", false);"
+                    ]
+                  }
+                }
+              ],
+              "request": {
+                "method": "POST",
+                "header": [
+                  {
+                    "key": "Content-Type",
+                    "value": "application/json"
+                  }
+                ],
+                "body": {
+                  "mode": "raw",
+                  "raw": "{\n  \"amount\": 603.27",
+                  "options": {
+                    "raw": {
+                      "language": "json"
+                    }
+                  }
+                },
+                "url": {
+                  "raw": "{{baseUrl}}/policies/{{reference}}/renewals",
+                  "host": ["{{baseUrl}}"],
+                  "path": ["policies", "{{reference}}", "renewals"]
+                }
+              }
+            }
+          ]
+        }
+      ]
     }
   ]
 }
