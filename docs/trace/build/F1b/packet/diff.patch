@@ -0,0 +1,53 @@
+using System.Reflection;
+using Uinsure.Policies.Architecture.Tests.Support;
+using Uinsure.Policies.Domain.Policies;
+using Xunit;
+
+namespace Uinsure.Policies.Architecture.Tests;
+
+// A13: Policy.Restore rebuilds a policy from stored state without running any rule, so only Persistence may
+// call it. Every method body in the four src assemblies is read; the test projects are not src and may call it.
+public sealed class PolicyRestoreTests
+{
+    [Fact]
+    public void Policy_has_a_public_static_Restore_that_returns_a_Policy()
+    {
+        var restore = Restores();
+
+        var method = Assert.Single(restore);
+        Assert.Equal(typeof(Policy), method.ReturnType);
+    }
+
+    [Fact]
+    public void Policy_Restore_is_called_from_Persistence_and_from_no_other_src_assembly()
+    {
+        var restore = Restores();
+        Assert.NotEmpty(restore);
+
+        var callers = SourceAssemblies.All
+            .SelectMany(assembly => MethodCalls.In(assembly)
+                .Where(call => restore.Contains(call.Callee))
+                .Select(call => (Assembly: assembly, call.Caller)))
+            .ToArray();
+
+        Assert.Contains(callers, call => call.Assembly == SourceAssemblies.Persistence);
+        Assert.Empty(callers
+            .Where(call => call.Assembly != SourceAssemblies.Persistence)
+            .Select(call => $"{call.Assembly.GetName().Name}: {call.Caller}"));
+    }
+
+    // The scan itself: a call made inside an async method (PolicyService.Sell's state machine calls Policy.Sell)
+    // is found and counted against the assembly it was written in, so an empty caller list means something.
+    [Fact]
+    public void Call_scan_finds_a_call_made_inside_an_async_method()
+    {
+        var sell = typeof(Policy).GetMethod(nameof(Policy.Sell), BindingFlags.Public | BindingFlags.Static);
+        Assert.NotNull(sell);
+
+        Assert.Contains(MethodCalls.In(SourceAssemblies.Services), call => call.Callee.Equals(sell));
+    }
+
+    private static MethodInfo[] Restores() =>
+        [.. typeof(Policy).GetMethods(BindingFlags.Public | BindingFlags.Static | BindingFlags.DeclaredOnly)
+            .Where(method => method.Name == "Restore")];
+}
diff --git a/tests/Uinsure.Policies.Architecture.Tests/Support/MethodCalls.cs b/tests/Uinsure.Policies.Architecture.Tests/Support/MethodCalls.cs
new file mode 100644
index 0000000..a86d495
--- /dev/null
+++ b/tests/Uinsure.Policies.Architecture.Tests/Support/MethodCalls.cs
@@ -0,0 +1,81 @@
+using System.Reflection;
+using System.Reflection.Emit;
+
+namespace Uinsure.Policies.Architecture.Tests.Support;
+
+// The methods a method body refers to (call, callvirt, newobj, ldftn, ldvirtftn), read from its IL with
+// reflection only. The IL is walked opcode by opcode, so an operand's bytes are never taken for an opcode.
+// Every type in an assembly is read, compiler-generated ones included, so a call from a lambda or an async
+// method's state machine counts against the assembly it was written in.
+internal static class MethodCalls
+{
+    private const BindingFlags Declared =
+        BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.Static | BindingFlags.DeclaredOnly;
+
+    private static readonly Dictionary<short, OpCode> OpCodesByValue = typeof(OpCodes)
+        .GetFields(BindingFlags.Public | BindingFlags.Static)
+        .Select(field => (OpCode)field.GetValue(null)!)
+        .ToDictionary(opCode => opCode.Value);
+
+    private static readonly HashSet<short> MethodReferences =
+    [
+        OpCodes.Call.Value, OpCodes.Callvirt.Value, OpCodes.Newobj.Value, OpCodes.Ldftn.Value, OpCodes.Ldvirtftn.Value,
+    ];
+
+    // Each (caller, callee) pair in the assembly, the caller named Type.Method.
+    public static IEnumerable<(string Caller, MethodBase Callee)> In(Assembly assembly) =>
+        assembly.GetTypes()
+            .SelectMany(type => type.GetMethods(Declared).Cast<MethodBase>().Concat(type.GetConstructors(Declared)))
+            .SelectMany(method => CalledBy(method).Select(callee => ($"{method.DeclaringType?.FullName}.{method.Name}", callee)));
+
+    public static IEnumerable<MethodBase> CalledBy(MethodBase method)
+    {
+        var il = method.GetMethodBody()?.GetILAsByteArray();
+        if (il is null)
+        {
+            yield break;
+        }
+
+        var position = 0;
+        while (position < il.Length)
+        {
+            short value = il[position++];
+            if (value == 0xFE)
+            {
+                value = (short)(0xFE00 | il[position++]);
+            }
+
+            var opCode = OpCodesByValue[value];
+            if (MethodReferences.Contains(opCode.Value) && Resolve(method, BitConverter.ToInt32(il, position)) is { } callee)
+            {
+                yield return callee;
+            }
+
+            position += OperandSize(opCode, il, position);
+        }
+    }
+
+    private static MethodBase? Resolve(MethodBase method, int token)
+    {
+        var typeArguments = method.DeclaringType is { IsGenericType: true } type ? type.GetGenericArguments() : null;
+        var methodArguments = method.IsGenericMethod ? method.GetGenericArguments() : null;
+        try
+        {
+            return method.Module.ResolveMethod(token, typeArguments, methodArguments);
+        }
+        catch (Exception exception) when (exception is ArgumentException or BadImageFormatException or TypeLoadException or FileNotFoundException)
+        {
+            return null;
+        }
+    }
+
+    private static int OperandSize(OpCode opCode, byte[] il, int position) => opCode.OperandType switch
+    {
+        OperandType.InlineNone => 0,
+        OperandType.ShortInlineBrTarget or OperandType.ShortInlineI or OperandType.ShortInlineVar => 1,
+        OperandType.InlineVar => 2,
+        OperandType.InlineI8 or OperandType.InlineR => 8,
+        OperandType.InlineSwitch => 4 + (4 * BitConverter.ToInt32(il, position)),
+        _ => 4,
+    };
+}
