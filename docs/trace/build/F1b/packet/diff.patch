@@ -0,0 +1,130 @@
+using Uinsure.Policies.Api.Tests.Builders;
+using Uinsure.Policies.Api.Tests.Support;
+using Xunit;
+
+namespace Uinsure.Policies.Api.Tests;
+
+// The amount's 400 shape rows (ruling H6): an amount with more than 2 decimal places, or above 1,000,000.00,
+// is rejected before any rule runs, with errors["amount"], and never rounded, so nothing ambiguous is stored.
+// A zero or negative amount within that scale stays the 422 SELL-7. Each side of each limit is its own test.
+// Shape is not a numbered rule, so the shape rows carry no Rule trait. The negative rows (finding A1/I2, I3)
+// show the shape check hands any negative amount with at most 2 decimal places, however large, over to
+// SELL-7, so they carry its trait.
+public sealed class SellAmountShapeTests : IClassFixture<PoliciesApiFactory>
+{
+    private const string Sell7Title = "Policy amount must be greater than zero";
+
+    private readonly PoliciesApiFactory _factory;
+
+    public SellAmountShapeTests(PoliciesApiFactory factory)
+    {
+        _factory = factory;
+        _factory.ResetClock();
+    }
+
+    [Fact]
+    public async Task Amount_with_2_decimal_places_is_accepted()
+    {
+        using var client = _factory.CreateClient();
+        var body = new SellPolicyRequestBuilder("AMOUNT-2DP").WithAmount(803.47m).Build();
+
+        var policy = await client.SellAndReadBack(body, "AMOUNT-2DP");
+
+        SoldPolicyAssert.ReadsBackAsSold(policy, body, "AMOUNT-2DP", new DateOnly(2027, 11, 7));
+        Assert.Equal(803.47m, policy.Member("amount").GetDecimal());
+    }
+
+    [Fact]
+    public async Task Amount_with_3_decimal_places_is_rejected_with_400()
+    {
+        using var client = _factory.CreateClient();
+        var body = new SellPolicyRequestBuilder("AMOUNT-3DP").WithAmount(527.185m).Build();
+
+        using var response = await client.PostPolicy(body);
+
+        ProblemAssert.HasError(await ProblemAssert.ValidationErrors(response), "amount");
+        await client.AssertNotStored("AMOUNT-3DP");
+    }
+
+    // Below a penny is a scale error, so it is the 400, not the 422 SELL-7 of a zero amount.
+    [Fact]
+    public async Task Amount_of_0_001_is_rejected_with_400()
+    {
+        using var client = _factory.CreateClient();
+        var body = new SellPolicyRequestBuilder("AMOUNT-0-001").WithAmount(0.001m).Build();
+
+        using var response = await client.PostPolicy(body);
+
+        ProblemAssert.HasError(await ProblemAssert.ValidationErrors(response), "amount");
+        await client.AssertNotStored("AMOUNT-0-001");
+    }
+
+    [Fact]
+    public async Task Amount_of_1_000_000_00_is_accepted()
+    {
+        using var client = _factory.CreateClient();
+        var body = new SellPolicyRequestBuilder("AMOUNT-1M").WithAmount(1_000_000.00m).Build();
+
+        var policy = await client.SellAndReadBack(body, "AMOUNT-1M");
+
+        SoldPolicyAssert.ReadsBackAsSold(policy, body, "AMOUNT-1M", new DateOnly(2027, 11, 7));
+        Assert.Equal(1_000_000.00m, policy.Member("amount").GetDecimal());
+    }
+
+    [Fact]
+    public async Task Amount_of_1_000_000_01_is_rejected_with_400()
+    {
+        using var client = _factory.CreateClient();
+        var body = new SellPolicyRequestBuilder("AMOUNT-1M-01").WithAmount(1_000_000.01m).Build();
+
+        using var response = await client.PostPolicy(body);
+
+        ProblemAssert.HasError(await ProblemAssert.ValidationErrors(response), "amount");
+        await client.AssertNotStored("AMOUNT-1M-01");
+    }
+
+    // The 1,000,000.00 cap bounds positive amounts only: a negative beyond it is still the 422 SELL-7, not a 400.
+    [Fact]
+    [Trait("Rule", "SELL-7")]
+    public async Task Amount_of_minus_1_000_000_01_is_rejected_with_422_SELL_7()
+    {
+        using var client = _factory.CreateClient();
+        var body = new SellPolicyRequestBuilder("SELL7-NEG-1M-01").WithAmount(-1_000_000.01m).Build();
+
+        using var response = await client.PostPolicy(body);
+
+        var problem = await ProblemAssert.SingleRuleViolation(response, "SELL-7", Sell7Title);
+        Assert.Equal(-1_000_000.01m, problem.Member("amount").GetDecimal());
+        await client.AssertNotStored("SELL7-NEG-1M-01");
+    }
+
+    // Below decimal.MinValue / 100, amount * 100 cannot be represented; the shape check must still answer.
+    [Fact]
+    [Trait("Rule", "SELL-7")]
+    public async Task Amount_of_minus_10_to_the_27_is_rejected_with_422_SELL_7()
+    {
+        using var client = _factory.CreateClient();
+        var body = new SellPolicyRequestBuilder("SELL7-NEG-E27").WithAmount(-1_000_000_000_000_000_000_000_000_000m).Build();
+
+        using var response = await client.PostPolicy(body);
+
+        var problem = await ProblemAssert.SingleRuleViolation(response, "SELL-7", Sell7Title);
+        Assert.Equal(-1_000_000_000_000_000_000_000_000_000m, problem.Member("amount").GetDecimal());
+        await client.AssertNotStored("SELL7-NEG-E27");
+    }
+
+    // The most negative amount that binds.
+    [Fact]
+    [Trait("Rule", "SELL-7")]
+    public async Task Amount_of_decimal_MinValue_is_rejected_with_422_SELL_7()
+    {
+        using var client = _factory.CreateClient();
+        var body = new SellPolicyRequestBuilder("SELL7-NEG-MIN").WithAmount(decimal.MinValue).Build();
+
+        using var response = await client.PostPolicy(body);
+
+        var problem = await ProblemAssert.SingleRuleViolation(response, "SELL-7", Sell7Title);
+        Assert.Equal(decimal.MinValue, problem.Member("amount").GetDecimal());
+        await client.AssertNotStored("SELL7-NEG-MIN");
+    }
+}
diff --git a/tests/Uinsure.Policies.Api.Tests/Support/ClientAbortedApiFactory.cs b/tests/Uinsure.Policies.Api.Tests/Support/ClientAbortedApiFactory.cs
new file mode 100644
index 0000000..2e57530
--- /dev/null
+++ b/tests/Uinsure.Policies.Api.Tests/Support/ClientAbortedApiFactory.cs
@@ -0,0 +1,109 @@
+using System.Collections.Concurrent;
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.TestHost;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Logging;
+using Uinsure.Policies.Domain.Policies;
+using Uinsure.Policies.Services;
+
+namespace Uinsure.Policies.Api.Tests.Support;
+
+// What the server did with one request, seen from outside the app's whole pipeline (after its exception handling).
+public sealed record ServedRequest(int Status, string? ContentType, bool Aborted);
+
+// Production over HTTPS, for a sale the client gives up on. The app's IPolicyRepository is wrapped so a lookup
+// of an armed reference waits on the request's own token until the client aborts, as a slow database call does
+// when the client goes away; the OperationCanceledException then comes from the real controller → service →
+// repository path. A middleware ahead of the app's pipeline records the status and content type the server
+// ended with for each request carrying the probe header, and a logger provider captures what is logged.
+public sealed class ClientAbortedApiFactory : ProductionApiFactory
+{
+    public const string ProbeHeader = "X-Test-Abort-Probe";
+
+    private readonly ConcurrentDictionary<string, TaskCompletionSource> _reached = new(StringComparer.Ordinal);
+    private readonly ConcurrentDictionary<string, TaskCompletionSource<ServedRequest>> _served = new(StringComparer.Ordinal);
+
+    public ClientAbortedApiFactory() => ClientOptions.BaseAddress = TransportClients.HttpsBaseAddress;
+
+    public CapturingLoggerProvider Logs { get; } = new();
+
+    // Arms the next lookup of the reference only. The task completes once that lookup is waiting, so the test
+    // aborts mid-request, never before the request reaches the repository.
+    public Task ArmLookup(string reference) =>
+        _reached.GetOrAdd(reference, _ => new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously)).Task;
+
+    // Completes when the request with this probe value has left the app's pipeline.
+    public Task<ServedRequest> Served(string probe) => ServedSignal(probe).Task;
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        base.ConfigureWebHost(builder);
+
+        builder.ConfigureTestServices(services =>
+        {
+            services.AddSingleton<ILoggerProvider>(Logs);
+            services.AddTransient<IStartupFilter>(_ => new ServedRequestRecorder(this));
+
+            var app = services.Single(descriptor => descriptor.ServiceType == typeof(IPolicyRepository));
+            var implementation = app.ImplementationType
+                ?? throw new InvalidOperationException("The app's IPolicyRepository is expected to be registered by type.");
+            services.Remove(app);
+            services.Add(new ServiceDescriptor(
+                typeof(IPolicyRepository),
+                provider => new StallingPolicyRepository((IPolicyRepository)ActivatorUtilities.CreateInstance(provider, implementation), this),
+                app.Lifetime));
+        });
+    }
+
+    private TaskCompletionSource<ServedRequest> ServedSignal(string probe) =>
+        _served.GetOrAdd(probe, _ => new TaskCompletionSource<ServedRequest>(TaskCreationOptions.RunContinuationsAsynchronously));
+
+    private sealed class ServedRequestRecorder(ClientAbortedApiFactory factory) : IStartupFilter
+    {
+        public Action<IApplicationBuilder> Configure(Action<IApplicationBuilder> next) => app =>
+        {
+            app.Use(async (context, nextMiddleware) =>
+            {
+                var probe = context.Request.Headers[ProbeHeader].ToString();
+                if (probe.Length == 0)
+                {
+                    await nextMiddleware(context);
+                    return;
+                }
+
+                try
+                {
+                    await nextMiddleware(context);
+                }
+                finally
+                {
+                    factory.ServedSignal(probe).TrySetResult(new ServedRequest(
+                        context.Response.StatusCode,
+                        context.Response.ContentType,
+                        context.RequestAborted.IsCancellationRequested));
+                }
+            });
+            next(app);
+        };
+    }
+
+    private sealed class StallingPolicyRepository(IPolicyRepository real, ClientAbortedApiFactory factory) : IPolicyRepository
+    {
+        public async Task<Policy?> GetByReference(PolicyReference reference, CancellationToken ct)
+        {
+            if (factory._reached.TryRemove(reference.Value, out var reached))
+            {
+                reached.TrySetResult();
+                await Task.Delay(Timeout.Infinite, ct);
+            }
+
+            return await real.GetByReference(reference, ct);
+        }
+
+        public void Add(Policy policy) => real.Add(policy);
+
+        public Task SaveChanges(CancellationToken ct) => real.SaveChanges(ct);
+    }
+}
