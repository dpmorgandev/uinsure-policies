#!/bin/sh
# commit-msg (guardrails.spec G9; traceability.spec trailers): on feature/* and bug/* branches every
# commit carries Agent, Plan and Node trailers, and Plan/Node match the branch.
set -u
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
case "$branch" in
  feature/*/*|bug/*/*) ;;
  *) exit 0 ;;
esac
plan="$(printf '%s' "$branch" | cut -d/ -f2)"
node="$(printf '%s' "$branch" | cut -d/ -f3)"

trailer() {
  git interpret-trailers --parse "$1" | sed -n "s/^$2: *//p" | head -1 | tr -d '\r'
}
agent="$(trailer "$1" Agent)"
msg_plan="$(trailer "$1" Plan)"
msg_node="$(trailer "$1" Node)"

case "$agent" in
  tester|builder|git|main) ;;
  *) echo "commit-msg: G9: missing or unknown Agent trailer ('$agent')" >&2; exit 1 ;;
esac
[ "$msg_plan" = "$plan" ] || { echo "commit-msg: G9: Plan trailer must be '$plan' (got '$msg_plan')" >&2; exit 1; }
[ "$msg_node" = "$node" ] || { echo "commit-msg: G9: Node trailer must be '$node' (got '$msg_node')" >&2; exit 1; }

# Every Fixes-Finding names its round: <A|D><n>[.<k>]/I<n> (F1 shipped bare `I2` ids that resolve to nothing).
bad="$(grep -E '^Fixes-Finding:' "$1" | tr -d '\r' | sed 's/^Fixes-Finding:[[:space:]]*//' | grep -vE '^[AD][0-9]+(\.[0-9]+)?/I[0-9]+$')"
[ -z "$bad" ] || { echo "commit-msg: G9: Fixes-Finding must be <round>/<id>, e.g. A1/I2 (got '$bad')" >&2; exit 1; }

# Tester and builder loop commits also carry Rule (an id, or `none` on a node without rules) and TDD.
# The QA script (a docs( commit) has no TDD step.
case "$agent" in
  tester|builder)
    [ -n "$(trailer "$1" Rule)" ] || { echo "commit-msg: G9: a $agent commit needs a Rule trailer (an id, or 'none')" >&2; exit 1; }
    subject="$(head -1 "$1" | tr -d '\r')"
    case "$subject" in
      docs\(*) ;;
      *)
        case "$(trailer "$1" TDD)" in
          scaffold|red|stub|green|refactor) ;;
          *) echo "commit-msg: G9: a $agent commit needs TDD: scaffold|red|stub|green|refactor" >&2; exit 1 ;;
        esac ;;
    esac ;;
esac
exit 0
