        { "file": "docs/trace/build/F1b/README.md", "head": 14 },
        { "file": "docs/trace/build/F2/README.md", "head": 14 },
        { "file": "docs/trace/build/F2/loop.jsonl", "match": "\"event\":\"(pause1|steer\\(|signoff\\(|merged\\(|attempt\\+\\+|investigation\\.opened)" }
