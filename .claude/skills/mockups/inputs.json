    },
    "rule": {
      "excerpts": [
        { "file": "docs/requirements.md", "match": "^\\| (GET-1|—) \\|" },
        { "file": "docs/trace/requirements-matrix.md", "match": "^\\| (rule|GET-1) \\|" },
        { "file": "docs/trace/build/F2/walkthrough.md", "match": "^(# |\\| # |\\|---|\\| \\d+ \\| [0-9a-f]+ \\| (red|stub|green|refactor) )" },
        { "file": "docs/trace/build/F2/README.md", "head": 14 },
        { "file": "docs/trace/build/F2/loop.jsonl", "match": "\"event\":\"(gate\\.(red|stub|green|refactor)|verdict\\(|attempt\\+\\+|signoff\\(|merged\\(|pr\\()" },
        { "file": "docs/qa/build-F2.md", "match": "^(Rule IDs:|\\| (Tester|Date|Commit signed off|Steps passed|Defects raised|Verdict|Signature) \\||\\| 1 \\| GET-1 \\|)" }
      ]
    }
  }
