{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Azure Pipelines subset used by this repo (hand-written, offline)",
  "description": "Covers the keys azure-pipelines.yml and stage-template.yml use. It is not the full Microsoft schema.",
  "type": "object",
  "properties": {
    "trigger": { "type": "object" },
    "pr": {},
    "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } },
    "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
    "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stageOrTemplate" } }
  },
  "required": ["stages"],
  "additionalProperties": false,
  "$defs": {
    "variable": {
      "type": "object",
      "oneOf": [
        { "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "value": { "type": ["string", "number"] } } },
        { "required": ["group"], "additionalProperties": false, "properties": { "group": { "type": "string" } } }
      ]
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "enum": ["string", "number", "boolean", "object", "step", "stepList", "job", "jobList", "deployment", "deploymentList", "stage", "stageList"] },
        "default": {},
        "values": { "type": "array" }
      },
      "additionalProperties": false
    },
    "stageOrTemplate": {
      "type": "object",
      "oneOf": [
        {
          "required": ["stage", "jobs"],
          "properties": {
            "stage": { "type": "string" },
            "displayName": { "type": "string" },
            "dependsOn": { "type": ["string", "array"] },
            "jobs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/job" } }
          },
          "additionalProperties": false
        },
        {
          "required": ["template"],
          "properties": {
            "template": { "type": "string" },
            "parameters": { "type": "object" }
          },
          "additionalProperties": false
        }
      ]
    },
    "pool": {
      "type": "object",
      "oneOf": [
        { "required": ["vmImage"], "properties": { "vmImage": { "type": "string" } }, "additionalProperties": false },
        { "required": ["name"], "properties": { "name": { "type": "string" } }, "additionalProperties": false }
      ]
    },
    "job": {
      "type": "object",
      "oneOf": [
        {
          "required": ["job", "steps"],
          "properties": {
            "job": { "type": "string" },
            "displayName": { "type": "string" },
            "dependsOn": { "type": ["string", "array"] },
            "pool": { "$ref": "#/$defs/pool" },
            "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } },
            "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
          },
          "additionalProperties": false
        },
        {
          "required": ["deployment", "environment", "strategy"],
          "properties": {
            "deployment": { "type": "string" },
            "displayName": { "type": "string" },
            "dependsOn": { "type": ["string", "array"] },
            "pool": { "$ref": "#/$defs/pool" },
            "environment": { "type": "string" },
            "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } },
            "strategy": {
              "type": "object",
              "required": ["runOnce"],
              "properties": {
                "runOnce": {
                  "type": "object",
                  "required": ["deploy"],
                  "properties": {
                    "deploy": {
                      "type": "object",
                      "required": ["steps"],
                      "properties": { "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } } },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "step": {
      "type": "object",
      "oneOf": [
        {
          "required": ["script"],
          "properties": { "script": { "type": "string" }, "displayName": { "type": "string" }, "name": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "required": ["publish", "artifact"],
          "properties": { "publish": { "type": "string" }, "artifact": { "type": "string" }, "displayName": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "required": ["download", "artifact"],
          "properties": { "download": { "enum": ["current"] }, "artifact": { "type": "string" }, "displayName": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "required": ["task"],
          "properties": {
            "task": { "type": "string", "pattern": "^[A-Za-z]+@[0-9]+$" },
            "displayName": { "type": "string" },
            "name": { "type": "string" },
            "inputs": { "type": "object" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
